<%= form_with model: @member_profile,
              url: member_profile_path,
              data: {
                      turbo_frame: "main",
                      controller: "form-validation",
                      "form-validation-context-value": "member_profile-new"
              },
              html: {
                class: "needs-validation",
                novalidate: true
              } do |f| %>

  <!-- 請求先 -->
  <div class="card mb-3">
    <div class="card-header">
      請求先
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item">

        <!-- アドレス帳からコピー -->
        <div class="d-flex justify-content-end mt-1 mb-3">
          <button type="button" class="btn btn-outline-primary" id="copyBtn">
            アドレス帳からコピー
          </button>
        </div>

        <!-- 請求先氏名 -->
        <div class="input-group mb-3">
          <span class="input-group-text">氏名</span>
          <%= f.text_field :billing_name, id: "name_field", class: "form-control", maxlength: 100, required: true %>
          <div class="invalid-feedback">
            請求先名は必須です（100文字以内）
          </div>
        </div>

        <!-- 請求先名カナ -->
        <div class="input-group mb-3">
          <span class="input-group-text">氏名カナ</span>
          <%= f.text_field :billing_name_kana, id: "name_kana_field", class: "form-control", maxlength: 100 %>
          <div class="invalid-feedback">
            請求先名カナは100文字以内です
          </div>
        </div>

        <!-- 請求先部署 -->
        <div class="input-group mb-3">
          <span class="input-group-text">部署</span>
          <%= f.text_field :billing_department, id: "department_field", class: "form-control", maxlength: 100 %>
          <div class="invalid-feedback">
            請求先部署は100文字以内です
          </div>
        </div>

        <!-- 請求先電話番号 -->
        <div class="input-group mb-3">
          <span class="input-group-text">電話番号</span>
          <%= f.telephone_field :billing_phone_number, id: "phone_number_field", class: "form-control", maxlength: 30, required: true, pattern: "[0-9()\\-]*" %>
          <div class="invalid-feedback">
            請求先電話番号は半角数字・( )・- のみで入力してください（30文字以内） 
          </div>
        </div>

        <%= render "shared/address_fields",
            form: f,
            prefectures: @prefectures,
            cities: @cities,
            zip_col:  :billing_postal_code,
            pref_col: :billing_prefecture_code,
            city_col: :billing_city_code,
            line_col: :billing_address_line %>

        <div class="d-flex justify-content-end form-check mb-4">
          <%= f.check_box :add_flag, class: "form-check-input me-2" %>
          <%= f.label :add_flag, "#{action}時にアドレス帳に追加する", class: "form-check-label" %>
        </div>

      </li>
    </ul>
  </div>
  <div class="d-flex">
    <%= f.submit "#{action}する", class: "btn btn-primary flex-grow-1" %>
  </div>
<% end %>