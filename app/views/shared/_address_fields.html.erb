<%#
  共通パーシャル
  必須: form
  任意: zip_col / pref_col / city_col / line_col
        （渡さなければデフォルト名）
%>
<% raise ArgumentError, "local :form is required" unless local_assigns[:form] %>
<% form = local_assigns[:form] %>
<% zip_col  = local_assigns.fetch(:zip_col,  :postal_code)      %>
<% pref_col = local_assigns.fetch(:pref_col, :prefecture_code)  %>
<% city_col = local_assigns.fetch(:city_col, :city_code)        %>
<% line_col = local_assigns.fetch(:line_col, :address_line)     %>
<% prefectures = local_assigns.fetch(:prefectures, []) %>
<% cities      = local_assigns.fetch(:cities, []) %>

<div id="addressContainer" data-controller="address" data-turbo-permanent>

  <!-- 郵便番号 & 検索ボタン -->
  <div class="input-group mb-3">
    <span class="input-group-text">郵便番号</span>
    <%= form.text_field zip_col,
          minlength: 7,
          maxlength: 7,
          required: true,
          class: "form-control",
          data: { address_target: "zip" } %>
    <button type="button" class="btn btn-outline-secondary"
            data-address-target="zipBtn"
            data-action="click->address#searchZip">
      住所を検索
    </button>
    <div class="invalid-feedback">
      ハイフンなしの７桁の半角数字で入力してください 
    </div>
  </div>

  <!-- 都道府県 -->
  <div class="input-group mb-3">
    <span class="input-group-text">都道府県</span>
    <%= form.select pref_col,
          options_from_collection_for_select(prefectures, :code, :name_ja, form.object.send(pref_col)),
          { include_blank: "-- 都道府県 --" },
          { class: "form-select",
            required: true,
            data: { address_target: "pref",
                    action: "change->address#loadCities" }
          } %>
    <div class="invalid-feedback">
      都道府県は必須です
    </div>
  </div>

  <!-- 市区町村 -->
  <div class="input-group mb-3">
    <span class="input-group-text">市区町村</span>
    <%= form.select city_col,
          options_from_collection_for_select(cities, :code, :name_ja, form.object.send(city_col)),
          { include_blank: "-- 市区町村 --" },
          {
            class: "form-select",
            required: true,
            data: { address_target: "city" }
          } %>
    <div class="invalid-feedback">
      市区町村は必須です
    </div>
  </div>

  <!-- 町域・番地など自由入力 -->
  <div class="input-group mb-3">
    <span class="input-group-text">以降の住所</span>
    <%= form.text_field line_col,
          class: "form-control",
          maxlength: 200,
          required: true,
          placeholder: "町域・番地など",
          data: { address_target: "addr1" } %>
    <div class="invalid-feedback">
      以降の住所は必須です（200文字以内） 
    </div>
  </div>

  <!-- 候補モーダル -->
  <div class="modal" tabindex="-1" data-address-target="modal">
    <div class="modal-dialog modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-body" data-address-target="modalBody">
          <!-- 動的に候補が入る -->
        </div>
      </div>
    </div>
  </div>
  <!-- アドレス帳モーダル -->
  <div class="modal" tabindex="-1" data-address-target="copy">
    <div class="modal-dialog modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-body" data-address-target="copyBody">
          <!-- 動的にアドレス帳が入る -->
        </div>
      </div>
    </div>
  </div>
</div>
