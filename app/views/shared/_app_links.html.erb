<%# --------------------------------------------
     必須 local:
       - placement: :side  または :bottom
--------------------------------------------- %>

<% menu = [
  { path: ->{ authenticated_root_path },       icon: "house",        label: "ホーム",     roles: [:member, :vendor, :admin, :affiliate] },
  { path: ->{ parts_path },      icon: "puzzle",       label: "マイパーツ", roles: [:member, :vendor, :admin, :affiliate], turbo: true },
  { path: ->{ recipes_path },    icon: "fork-knife",   label: "マイレシピ", roles: [:member, :vendor, :admin, :affiliate], turbo: true },
  { path: ->{ carts_path },      icon: "cart4",        label: "カート",     roles: [:member, :vendor, :admin, :affiliate], turbo: true },
  { path: ->{ admin_root_path }, icon: "shield-lock",  label: "管理",       roles: [:admin], turbo: true }
] %>

<% menu.each do |item| %>
  <% next unless Current.account&.has_role_in?(item[:roles]) %>  <%# ← ロールチェック %>
  <% link_opts = item[:turbo] ? { data:{ turbo_frame:"main"} } : {} %>

  <% if placement == :side %>
    <%= link_to item[:path].call, { class:"SideLink mb-2 link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover" }.merge(link_opts) do %>
      <i class="bi bi-<%= item[:icon] %> fs-4" aria-label="<%= item[:label] %>"></i>
      <span class="SideLabel ms-3"><%= item[:label] %></span>
    <% end %>

  <% else %> <%# :bottom %>
    <%= link_to item[:path].call, { class:"BottomLink flex-fill" }.merge(link_opts) do %>
      <i class="bi bi-<%= item[:icon] %> fs-5"></i>
    <% end %>
  <% end %>
<% end %>
