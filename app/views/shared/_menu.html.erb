<nav class="nav flex-column gap-1">
  <% if user_signed_in? %>
    <% role_partial = "shared/menu/#{current_user.role}" %>

    <%# パーシャルが存在すれば表示、無ければスキップ %>
    <% if lookup_context.exists?(role_partial, [], true) %>
      <%= render role_partial %>
    <% end %>

  <% else %>
    <%# ゲスト用メニューがあれば表示（無ければ何も出さない） %>
    <%= render "shared/menu/guest" if lookup_context.exists?("shared/menu/guest", [], true) %>
  <% end %>
</nav>
