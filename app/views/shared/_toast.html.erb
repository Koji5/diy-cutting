<!-- app/views/shared/_toast.html.erb -->
<% if flash[:notice] %>
  <div class="position-fixed bottom-0 end-0 p-3" style="z-index:11">
    <div class="toast show align-items-center text-bg-success" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
      <div class="d-flex">
        <div class="toast-body"><%= flash[:notice] %></div>
      </div>
    </div>
  </div>
<% end %>
