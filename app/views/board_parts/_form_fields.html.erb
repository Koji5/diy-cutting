  <% current_mode = (local_assigns[:mode] || :new).to_sym %>
  <% board_part = f.object.board_part || BoardPart.new %>
  <% raw_holes = board_part.hole_json.presence || {} %>
  <% holes = raw_holes.is_a?(Hash) ? raw_holes.deep_stringify_keys : {} %>
  <% max_n = holes.keys.filter_map { |k| k[/\Ah(\d+)\z/, 1]&.to_i }.max || 0 %>
  <% next_index = max_n + 1 %>

  <div class="carousel-inner"
      data-controller="board-part-form"
      data-board-part-form-base-path-value="part[board_part_attributes][hole_json]"
      data-board-part-form-next-index-value="<%= next_index %>"
      data-board-part-form-colors-value="<%= json_escape(@paint_colors.map { |c|
              { code: c.code, name: c.name_ja, sort: c.sort_order, allow: c.allow_paint_types }
            }.to_json) %>"
      data-board-part-form-glosses-value="<%= json_escape(@paint_glosses.map { |g|
              { code: g.code, name: g.name_ja, sort: g.sort_order, allow: g.allow_paint_types }
            }.to_json) %>">
    <%= f.fields_for :board_part do |bf| %>
      <%= bf.hidden_field :camera_state_json, id: "camera_state_json" %>
      <div class="carousel-item active px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 scroll-area col">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">基本形状</div>
              <div class="input-group">
                <span class="input-group-text">板の横巾 (mm)</span>
                <%= bf.number_field :length_mm, step: 0.1, class: "form-control", required: true %>
                <div class="invalid-feedback">
                  板の横巾 は必須です
                </div>
              </div>
              <div class="form-text mb-2">
                板の横巾は2000mm以内で入力してください。
              </div>
              <div class="input-group">
                <span class="input-group-text">板の縦巾 (mm)</span>
                <%= bf.number_field :width_mm, step: 0.1, class: "form-control", required: true %>
                <div class="invalid-feedback">
                  板の縦巾 は必須です
                </div>
              </div>
              <div class="form-text mb-2">
                板の縦巾は1000mm以内で入力してください。
              </div>
              <div class="input-group">
                <span class="input-group-text">板の厚み</span>
                <%= bf.collection_select :thickness_mm, @board_thickness, :thickness_mm, :name_en,
                                      { prompt: "選択…" },
                                      class: "form-select", required: true %>
                <div class="invalid-feedback">
                  板の厚みは必須です
                </div>
              </div>
            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>
      <%# コーナー加工 %>
      <div class="carousel-item px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 col scroll-area">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">コーナー加工</div>
              <% corners = { tl: "左上", tr: "右上", bl: "左下", br: "右下" } %>
              <% corners.each do |key, label| %>
                <% h = (bf.object.corner_json || {}).dig(key.to_s) || {} %>
                <% sel = h["proc"].presence || "NONE" %>
                <% edge_sel = h["edge"].presence || "NONE" %>
                <% formName = "part[board_part_attributes][corner_json][#{key}][disp]" %>
                <% checked_attr = (h["disp"].to_s == "true") ? 'checked="checked"' : '' %>
                <div class="d-flex flex-row flex-grow-1">
                  <div class="d-flex flex-grow-1 fw-bold fs-5 mb-2 ps-2" id="corner_<%= "#{key}" %>"><%= "#{label}" %></div>
                  <div class="d-flex form-check form-switch pt-1">
                    <input class="form-check-input" type="checkbox" id="corner_<%= "#{key}" %>_disp" name="<%= formName %>" <%= checked_attr %>>
                  </div>
                  <label class="form-check-label form-text" for="corner_<%= "#{key}" %>_disp">非表示 <i class="bi bi-arrow-left-right"></i> 表示</label>
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text">加工方法</span>
                  <%= select_tag "part[board_part_attributes][corner_json][#{key}][proc]",
                                  options_from_collection_for_select(@corner_processes, :code, :name_ja, sel),
                                  class: "form-select" %>
                </div>
                <div class="input-group">
                  <span class="input-group-text">加工範囲X (mm)</span>
                  <%= number_field_tag "part[board_part_attributes][corner_json][#{key}][dx]",
                                        h["dx"],
                                        step: 0.1, class: "form-control" %>
                  <div class="invalid-feedback">
                    加工範囲X は必須です
                  </div>
                </div>
                <div class="form-text mb-2">
                  <%= "#{label}" %>角からのX軸の加工範囲を入力してください。
                </div>
                <div class="input-group">
                  <span class="input-group-text">加工範囲Y (mm)</span>
                  <%= number_field_tag "part[board_part_attributes][corner_json][#{key}][dy]",
                                        h["dy"],
                                        step: 0.1, class: "form-control" %>
                  <div class="invalid-feedback">
                    加工範囲Y は必須です
                  </div>
                </div>
                <div class="form-text mb-3">
                  <%= "#{label}" %>角からのY軸の加工範囲を入力してください。
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text">エッジ加工</span>
                  <%= select_tag "part[board_part_attributes][corner_json][#{key}][edge]",
                                  options_from_collection_for_select(@edge_processes, :code, :name_ja, edge_sel),
                                  class: "form-select" %>
                </div>
              <% end %>
            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>

      <%# 辺加工 %>
      <div class="carousel-item px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 col scroll-area">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">辺加工</div>
              <% corners = { l: "左", t: "上", r: "右", b: "下" } %>
              <% corners.each do |key, label| %>
                <% h = (bf.object.side_json || {}).dig(key.to_s) || {} %>
                <% sel = h["proc"].presence || "NONE" %>
                <% edge_sel = h["edge"].presence || "NONE" %>
                <% checked_attr = (h["disp"].to_s == "true") ? 'checked="checked"' : '' %>
                <% formName = "part[board_part_attributes][side_json][#{key}][disp]" %>
                <div class="d-flex flex-row flex-grow-1">
                  <div class="d-flex flex-grow-1 fw-bold fs-5 mb-2 ps-2"><%= "#{label}" %>辺加工</div>
                  <div class="d-flex form-check form-switch pt-1">
                    <input class="form-check-input" type="checkbox" id="side_<%= "#{key}" %>_disp" name="<%= formName %>" <%= checked_attr %>>
                  </div>
                  <label class="form-check-label form-text" for="side_<%= "#{key}" %>_disp">非表示 <i class="bi bi-arrow-left-right"></i> 表示</label>
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text">加工方法</span>
                  <%= select_tag "part[board_part_attributes][side_json][#{key}][proc]",
                                  options_from_collection_for_select(@side_processes, :code, :name_ja, sel),
                                  class: "form-select" %>
                </div>
                <div class="input-group">
                  <span class="input-group-text">巾 (mm)</span>
                  <%= number_field_tag "part[board_part_attributes][side_json][#{key}][sd]",
                                        h["sd"],
                                        step: 0.1, class: "form-control" %>
                  <div class="invalid-feedback">
                    加工巾 は必須です
                  </div>
                </div>
                <div class="form-text mb-2">
                  <%= "#{label}" %>辺の加工巾を入力してください。
                </div>
                <div class="input-group">
                  <span class="input-group-text">深さ (mm)</span>
                  <%= number_field_tag "part[board_part_attributes][side_json][#{key}][sw]",
                                        h["sw"],
                                        step: 0.1, class: "form-control" %>
                  <div class="invalid-feedback">
                    加工深さ は必須です
                  </div>
                </div>
                <div class="form-text mb-3">
                  <%= "#{label}" %>辺の加工深さを入力してください。
                </div>
                <div class="input-group">
                  <span class="input-group-text">加工位置 (mm)</span>
                  <%= number_field_tag "part[board_part_attributes][side_json][#{key}][sp]",
                                        h["sp"],
                                        step: 0.1, class: "form-control" %>
                  <div class="invalid-feedback">
                    加工位置 は必須です
                  </div>
                </div>
                <div class="form-text mb-2">
                  <%= "#{label}" %>辺の加工位置を入力してください。
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text">エッジ加工</span>
                  <%= select_tag "part[board_part_attributes][side_json][#{key}][edge]",
                                  options_from_collection_for_select(@edge_processes, :code, :name_ja, edge_sel),
                                  class: "form-select" %>
                </div>
              <% end %>
            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>

      <%# ネジ・ダボ穴加工 %>
      <div class="carousel-item px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 col scroll-area"
                  data-board-part-form-target="scroller">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">ネジ・ダボ穴加工</div>
              <%# 行リスト %>
              <div data-board-part-form-target="list">
                <%# キー順は h1, h2, ... の数値順に並べる（数字が無い場合も安定化） %>
                <% ordered_keys = holes.keys.sort_by { |k| [k[/\d+/].to_i, k] } %>
                <% ordered_keys.each do |hid| %>
                  <div class="border rounded-3 p-3 mb-3 row-collapsible" data-board-part-form-target="row" data-hid="<%= hid %>">
                    <% h = holes[hid] || {} %>
                    <% surface_sel = h["surface"].presence || "LEFT" %>
                    <% base = "part[board_part_attributes][hole_json][#{hid}]" %>
                    <% checked_attr = (h["disp"].to_s == "true") ? 'checked="checked"' : '' %>
                    <% checked_attr_countersink = (h["countersink"].to_s == "true") ? 'checked="checked"' : '' %>
                    <div class="d-flex flex-row flex-grow-1">
                      <div class="d-flex flex-grow-1 fw-bold fs-5 mb-2 ps-2">穴 <%= hid.sub(/^h/, '') %></div>
                      <div class="px-3">
                        <button type="button" class="btn btn-outline-danger btn-sm"
                                data-action="board-part-form#remove" aria-label="この穴行を削除">
                          <i class="bi bi-trash"></i>
                        </button>
                      </div>
                      <div class="d-flex form-check form-switch pt-1">
                        <input class="form-check-input" type="checkbox" id="hole_<%= "#{hid}" %>_disp" name="<%= "#{base}[disp]" %>" <%= checked_attr %>>
                      </div>
                      <label class="form-check-label form-text" for="hole_<%= "#{hid}" %>_disp">非表示 <i class="bi bi-arrow-left-right"></i> 表示</label>
                    </div>

                    <div class="input-group mb-2">
                      <span class="input-group-text">加工面</span>
                      <%= select_tag "#{base}[surface]",
                                      options_from_collection_for_select(@hole_surfaces, :code, :name_ja, surface_sel),
                                      class: "form-select" %>
                    </div>
                    <div class="form-text mb-2">穴加工を行う面を選択してください。</div>

                    <div class="input-group">
                      <span class="input-group-text">穴位置X (mm)</span>
                      <%= number_field_tag "#{base}[dx]",
                                            h["dx"],
                                            step: 0.1, class: "form-control" %>
                      <div class="invalid-feedback">穴位置X は必須です</div>
                    </div>
                    <div class="form-text mb-2">X軸（左から）の穴位置を入力してください。</div>

                    <div class="input-group">
                      <span class="input-group-text">穴位置Y (mm)</span>
                      <%= number_field_tag "#{base}[dy]",
                                            h["dy"],
                                            step: 0.1, class: "form-control" %>
                      <div class="invalid-feedback">穴位置Y は必須です</div>
                    </div>
                    <div class="form-text mb-3">Y軸（下から）の穴位置を入力してください。</div>

                    <div class="input-group mb-2">
                      <span class="input-group-text">穴径</span>
                      <%= select_tag "#{base}[spec_code]",
                                      options_from_collection_for_select(@hole_specs, :code, :name_ja, h["spec_code"]),
                                      class: "form-select" %>
                      <div class="input-group-text">
                        <input class="form-check-input" type="checkbox" value=true id="hole_<%= "#{hid}" %>_countersink" name="<%= "#{base}[countersink]" %>" <%= checked_attr_countersink %>>
                        <label class="form-check-label mx-2" for="hole_<%= "#{hid}" %>_countersink">皿取り加工</label>
                      </div>
                    </div>
                    <div class="form-text mb-3">穴径、皿取り加工の有無を入力してください。</div>

                    <div class="input-group">
                      <span class="input-group-text">穴の深さ(mm)</span>
                      <%= number_field_tag "#{base}[depth]",
                                            h["depth"],
                                            step: 0.1, class: "form-control" %>
                      <div class="invalid-feedback">穴の深さは必須です</div>
                    </div>
                    <div class="form-text mb-1">加工面からの穴の深さを入力してください。</div>
                  </div>
                <% end %>
              </div>

              <%# 追加ボタン %>
              <button type="button" class="btn btn-sm btn-primary" data-action="board-part-form#add">
                <i class="bi bi-plus-lg me-1"></i>穴を追加
              </button>

              <%# 空のときだけ見せる %>
              <div data-board-part-form-target="empty" class="<%= holes.empty? ? '' : 'd-none' %>">
                <div class="callout callout-warning" role="note" aria-label="注意">
                  <div class="callout-title">
                    <i class="bi bi-exclamation-triangle me-1"></i> 注意
                  </div>
                  <p class="mb-0">ネジ・ダボ穴はまだ作成されていません。 「穴を追加」ボタンをクリックしてください。</p>
                </div>
              </div>

              <%# === 追加用テンプレート（__HID__ を Stimulus で置換） === %>
              <template data-board-part-form-target="template">
                <div class="border rounded-3 p-3 mb-3 row-collapsible" data-board-part-form-target="row">
                  <div class="d-flex flex-row flex-grow-1">
                    <div class="d-flex flex-grow-1 fw-bold fs-5 mb-2 ps-2">穴 __HNUM__</div>
                    <div class="px-3">
                      <button type="button" class="btn btn-outline-danger btn-sm"
                              data-action="board-part-form#remove" aria-label="この穴行を削除">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                    <div class="d-flex form-check form-switch pt-1">
                      <input class="form-check-input" type="checkbox" id="hole___HID___disp"
                            name="part[board_part_attributes][hole_json][__HID__][disp]">
                    </div>
                    <label class="form-check-label form-text" for="hole___HID___disp">非表示 <i class="bi bi-arrow-left-right"></i> 表示</label>
                  </div>

                  <div class="input-group mb-2">
                    <span class="input-group-text">加工面</span>
                    <select class="form-select"
                            name="part[board_part_attributes][hole_json][__HID__][surface]">
                      <% @hole_surfaces.each do |s| %>
                        <option value="<%= s.code %>"><%= s.name_ja %></option>
                      <% end %>
                    </select>
                  </div>
                  <div class="form-text mb-2">穴加工を行う面を選択してください。</div>

                  <div class="input-group">
                    <span class="input-group-text">穴位置X (mm)</span>
                    <input type="number" step="0.1" class="form-control"
                          name="part[board_part_attributes][hole_json][__HID__][dx]">
                    <div class="invalid-feedback">穴位置X は必須です</div>
                  </div>
                  <div class="form-text mb-2">X軸（左から）の穴位置を入力してください。</div>

                  <div class="input-group">
                    <span class="input-group-text">穴位置Y (mm)</span>
                    <input type="number" step="0.1" class="form-control"
                          name="part[board_part_attributes][hole_json][__HID__][dy]">
                    <div class="invalid-feedback">穴位置Y は必須です</div>
                  </div>
                  <div class="form-text mb-3">Y軸（下から）の穴位置を入力してください。</div>

                  <div class="input-group mb-2">
                    <span class="input-group-text">穴径</span>
                    <select class="form-select"
                            name="part[board_part_attributes][hole_json][__HID__][spec_code]">
                      <% @hole_specs.each do |sp| %>
                        <option value="<%= sp.code %>"><%= sp.name_ja %></option>
                      <% end %>
                    </select>
                    <div class="input-group-text">
                      <input class="form-check-input" type="checkbox" value=true
                            id="hole___HID___countersink"
                            name="part[board_part_attributes][hole_json][__HID__][countersink]">
                      <label class="form-check-label mx-2" for="hole___HID___countersink">皿取り加工</label>
                    </div>
                  </div>
                  <div class="form-text mb-3">穴径、皿取り加工の有無を入力してください。</div>

                  <div class="input-group">
                    <span class="input-group-text">穴の深さ(mm)</span>
                    <input type="number" step="0.1" class="form-control"
                          name="part[board_part_attributes][hole_json][__HID__][depth]">
                    <div class="invalid-feedback">穴の深さは必須です</div>
                  </div>
                  <div class="form-text mb-1">加工面からの穴の深さを入力してください。</div>
                </div>
              </template>

            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>

      <%# 材質・塗装 %>
      <div class="carousel-item px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 col scroll-area"
                  data-board-part-form-target="scroller">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">材質・塗装</div>

              <div class="input-group">
                <span class="input-group-text">材質</span>
                <%= bf.collection_select :material_code, @materials, :code, :name_ja,
                                      { prompt: "選択…" },
                                      class: "form-select", required: true %>
                <div class="invalid-feedback">
                  材質は必須です
                </div>
              </div>

              <div class="input-group">
                <span class="input-group-text">塗装タイプ</span>
                <%= bf.collection_select :paint_type_code, @paint_types, :code, :name_ja,
                                      { include_blank: "選択してください" },
                                      class: "form-select",
                                      required: true,
                                      data: { board_part_form_target: "type", action: "change->board-part-form#onTypeChange" } %>
                <div class="invalid-feedback">
                  塗装タイプは必須です
                </div>
              </div>

              <div class="input-group">
                <span class="input-group-text">カラー</span>
                <%= bf.select :paint_color_code, [],
                                      { include_blank: "先に塗装タイプを選択してください" },
                                      class: "form-select",
                                      data: {
                                        board_part_form_target: "color",
                                        current_value: bf.object.paint_color_code
                                      } %>
              </div>

              <div class="input-group">
                <span class="input-group-text">艶</span>
                <%= bf.select :paint_gloss_code, [],
                                      { include_blank: "先に塗装タイプを選択してください" },
                                      class: "form-select",
                                      data: {
                                        board_part_form_target: "gloss",
                                        current_value: bf.object.paint_gloss_code
                                      } %>
              </div>

            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>

      <%# DEBUG %>
      <div class="carousel-item px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 col scroll-area">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">DEBUG</div>
              <pre><%= raw json_escape(
                JSON.pretty_generate(
                  @part.as_json(
                    only: [:id, :name, :note, :shape_type_code],
                    include: {
                      board_part:  { except: [:created_at, :updated_at] }
                    }
                  )
                )
              ) %></pre>
            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>

    <% end %>
    <div class="carousel-item px-4">
      <div class="container">
        <div class="row carousel-row">
          <div class="col carousel-padding"></div>
          <div class="d-block w-100 col scroll-area">
            <div class="ProcessingHeader fw-bold fs-4 mb-2">パーツ情報</div>

            <div class="input-group mb-3">
              <span class="input-group-text">部品名称</span>
              <%= f.text_field :name, class: "form-control", maxlength: 50, required: true %>
              <div class="invalid-feedback">
                部品名称は必須です（50文字以内）
              </div>
            </div>
            <div class="card mb-3">
              <div class="card-header">
                説明文
              </div>
              <%= f.text_area :note,
                      class: "form-control",
                      rows: 2,
                      maxlength: 1000,
                      placeholder: "説明文などをご記入ください" %>
            </div>
            <div class="d-flex flex-grow-1">
              <%= f.submit (current_mode == :edit ? "マイパーツを更新する" : "マイパーツを登録する"),
                          class: "btn btn-primary flex-grow-1" %>
            </div>
          </div>
          <div class="col carousel-padding"></div>
        </div>
      </div>
    </div>
  </div>

  <button class="carousel-control-prev" type="button" data-bs-target="#boardPartForm" data-bs-slide="prev" data-bs-theme="dark">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#boardPartForm" data-bs-slide="next" data-bs-theme="dark">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>