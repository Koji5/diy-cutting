  <div class="carousel-inner">
    <%= f.fields_for :board_part do |bf| %>
      <%= bf.hidden_field :camera_state_json, id: "camera_state_json" %>
      <div class="carousel-item active px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 scroll-area col">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">基本形状</div>
              <div class="input-group">
                <span class="input-group-text">板の横巾 (mm)</span>
                <%= bf.number_field :length_mm, step: 0.1, class: "form-control", required: true %>
                <div class="invalid-feedback">
                  板の横巾 は必須です
                </div>
              </div>
              <div class="form-text mb-2">
                板の横巾は2000mm以内で入力してください。
              </div>
              <div class="input-group">
                <span class="input-group-text">板の縦巾 (mm)</span>
                <%= bf.number_field :width_mm, step: 0.1, class: "form-control", required: true %>
                <div class="invalid-feedback">
                  板の縦巾 は必須です
                </div>
              </div>
              <div class="form-text mb-2">
                板の縦巾は1000mm以内で入力してください。
              </div>
              <div class="input-group">
                <span class="input-group-text">板の厚み</span>
                <%= bf.collection_select :thickness_mm, @board_thickness, :thickness_mm, :name_en,
                                      { prompt: "選択…" },
                                      class: "form-select", required: true %>
                <div class="invalid-feedback">
                  板の厚みは必須です
                </div>
              </div>
            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>
      <%# コーナー加工 %>
      <div class="carousel-item px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 col scroll-area">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">コーナー加工</div>
              <% corners = { tl: "左上", tr: "右上", bl: "左下", br: "右下" } %>
              <% corners.each do |key, label| %>
                <% h = (bf.object.corner_json || {}).dig(key.to_s) || {} %>
                <% sel = h["proc"].presence || "NONE" %>
                <% edge_sel = h["edge"].presence || "NONE" %>
                <% formName = "part[board_part_attributes][corner_json][#{key}][disp]" %>
                <div class="d-flex flex-row flex-grow-1">
                  <div class="d-flex flex-grow-1 fw-bold fs-5 mb-2 ps-2" id="corner_<%= "#{key}" %>"><%= "#{label}" %></div>
                  <div class="d-flex form-check form-switch pt-1">
                    <input class="form-check-input" type="checkbox" id="corner_<%= "#{key}" %>_disp" name=<%= formName %>>
                  </div>
                  <label class="form-check-label form-text" for="corner_<%= "#{key}" %>_disp">非表示 <i class="bi bi-arrow-left-right"></i> 表示</label>
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text">加工方法</span>
                  <%= select_tag "part[board_part_attributes][corner_json][#{key}][proc]",
                                  options_from_collection_for_select(@corner_processes, :code, :name_ja, sel),
                                  class: "form-select" %>
                </div>
                <div class="input-group">
                  <span class="input-group-text">加工範囲X (mm)</span>
                  <%= number_field_tag "part[board_part_attributes][corner_json][#{key}][dx]",
                                        h["dx"],
                                        step: 0.1, class: "form-control" %>
                  <div class="invalid-feedback">
                    加工範囲X は必須です
                  </div>
                </div>
                <div class="form-text mb-2">
                  <%= "#{label}" %>角からのX軸の加工範囲を入力してください。
                </div>
                <div class="input-group">
                  <span class="input-group-text">加工範囲Y (mm)</span>
                  <%= number_field_tag "part[board_part_attributes][corner_json][#{key}][dy]",
                                        h["dy"],
                                        step: 0.1, class: "form-control" %>
                  <div class="invalid-feedback">
                    加工範囲Y は必須です
                  </div>
                </div>
                <div class="form-text mb-3">
                  <%= "#{label}" %>角からのY軸の加工範囲を入力してください。
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text">エッジ加工</span>
                  <%= select_tag "part[board_part_attributes][corner_json][#{key}][edge]",
                                  options_from_collection_for_select(@edge_processes, :code, :name_ja, edge_sel),
                                  class: "form-select" %>
                </div>
              <% end %>
            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>

      <%# 辺加工 %>
      <div class="carousel-item px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 col scroll-area">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">辺加工</div>
              <% corners = { l: "左", t: "上", r: "右", b: "下" } %>
              <% corners.each do |key, label| %>
                <% h = (bf.object.side_json || {}).dig(key.to_s) || {} %>
                <% sel = h["proc"].presence || "NONE" %>
                <% edge_sel = h["edge"].presence || "NONE" %>
                <% formName = "part[board_part_attributes][side_json][#{key}][disp]" %>
                <div class="d-flex flex-row flex-grow-1">
                  <div class="d-flex flex-grow-1 fw-bold fs-5 mb-2 ps-2"><%= "#{label}" %>辺加工</div>
                  <div class="d-flex form-check form-switch pt-1">
                    <input class="form-check-input" type="checkbox" id="side_<%= "#{key}" %>_disp" name=<%= formName %>>
                  </div>
                  <label class="form-check-label form-text" for="side_<%= "#{key}" %>_disp">非表示 <i class="bi bi-arrow-left-right"></i> 表示</label>
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text">加工方法</span>
                  <%= select_tag "part[board_part_attributes][side_json][#{key}][proc]",
                                  options_from_collection_for_select(@side_processes, :code, :name_ja, sel),
                                  class: "form-select" %>
                </div>
                <div class="input-group">
                  <span class="input-group-text">巾 (mm)</span>
                  <%= number_field_tag "part[board_part_attributes][side_json][#{key}][sd]",
                                        h["sd"],
                                        step: 0.1, class: "form-control" %>
                  <div class="invalid-feedback">
                    加工巾 は必須です
                  </div>
                </div>
                <div class="form-text mb-2">
                  <%= "#{label}" %>辺の加工巾を入力してください。
                </div>
                <div class="input-group">
                  <span class="input-group-text">深さ (mm)</span>
                  <%= number_field_tag "part[board_part_attributes][side_json][#{key}][sw]",
                                        h["sw"],
                                        step: 0.1, class: "form-control" %>
                  <div class="invalid-feedback">
                    加工深さ は必須です
                  </div>
                </div>
                <div class="form-text mb-3">
                  <%= "#{label}" %>辺の加工深さを入力してください。
                </div>
                <div class="input-group">
                  <span class="input-group-text">加工位置 (mm)</span>
                  <%= number_field_tag "part[board_part_attributes][side_json][#{key}][sp]",
                                        h["sp"],
                                        step: 0.1, class: "form-control" %>
                  <div class="invalid-feedback">
                    加工位置 は必須です
                  </div>
                </div>
                <div class="form-text mb-2">
                  <%= "#{label}" %>辺の加工位置を入力してください。
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text">エッジ加工</span>
                  <%= select_tag "part[board_part_attributes][side_json][#{key}][edge]",
                                  options_from_collection_for_select(@edge_processes, :code, :name_ja, edge_sel),
                                  class: "form-select" %>
                </div>
              <% end %>
            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>

      <%# ネジ・ダボ穴加工 %>
      <div class="carousel-item px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 col scroll-area">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">ネジ・ダボ穴加工</div>
              <% raw_holes = bf.object.hole_json.presence || {} %>
              <% holes = raw_holes.is_a?(Hash) ? raw_holes.deep_stringify_keys : {} %>
              <%# new で空なら 1 行だけ空欄を出す（キーは h1） %>
              <% holes = { "h1" => {} } if holes.empty? %>
              <%# キー順は h1, h2, ... の数値順に並べる（数字が無い場合も安定化） %>
              <% ordered_keys = holes.keys.sort_by { |k| [k[/\d+/].to_i, k] } %>
              <% ordered_keys.each do |hid| %>
                <% h = holes[hid] || {} %>
                <% surface_sel = h["surface"].presence || "LEFT" %>
                <% base = "part[board_part_attributes][hole_json][#{hid}]" %>
                <div class="d-flex flex-row flex-grow-1">
                  <div class="d-flex flex-grow-1 fw-bold fs-5 mb-2 ps-2">穴 <%= hid.sub(/^h/, '') %></div>
                  <div class="d-flex form-check form-switch pt-1">
                    <input class="form-check-input" type="checkbox" id="hole_<%= "#{hid}" %>_disp" name="<%= "#{base}[disp]" %>">
                  </div>
                  <label class="form-check-label form-text" for="hole_<%= "#{hid}" %>_disp">非表示 <i class="bi bi-arrow-left-right"></i> 表示</label>
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text">加工面</span>
                  <%= select_tag "#{base}[surface]",
                                  options_from_collection_for_select(@hole_surfaces, :code, :name_ja, surface_sel),
                                  class: "form-select" %>
                </div>
                <div class="form-text mb-2">
                  穴加工を行う面を選択してください。
                </div>
                <div class="input-group">
                  <span class="input-group-text">穴位置X (mm)</span>
                  <%= number_field_tag "#{base}[dx]",
                                        h["dx"],
                                        step: 0.1, class: "form-control" %>
                  <div class="invalid-feedback">
                    穴位置X は必須です
                  </div>
                </div>
                <div class="form-text mb-2">
                  X軸（左から）の穴位置を入力してください。
                </div>
                <div class="input-group">
                  <span class="input-group-text">穴位置Y (mm)</span>
                  <%= number_field_tag "#{base}[dy]",
                                        h["dy"],
                                        step: 0.1, class: "form-control" %>
                  <div class="invalid-feedback">
                    穴位置Y は必須です
                  </div>
                </div>
                <div class="form-text mb-3">
                  Y軸（下から）の穴位置を入力してください。
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text">穴径</span>
                  <%= select_tag "#{base}[spec_code]",
                                  options_from_collection_for_select(@hole_specs, :code, :name_ja, h["spec_code"]),
                                  class: "form-select" %>
                  <div class="input-group-text">
                    <input class="form-check-input" type="checkbox" value=true id="hole_<%= "#{hid}" %>_countersink" name="<%= "#{base}[countersink]" %>">
                    <label class="form-check-label mx-2" for="hole_<%= "#{hid}" %>_countersink">
                      皿取り加工
                    </label>
                  </div>
                </div>
                <div class="form-text mb-3">
                  穴径、皿取り加工の有無を入力してください。
                </div>
                <div class="input-group">
                  <span class="input-group-text">穴の深さ(mm)</span>
                  <%= number_field_tag "#{base}[depth]",
                                        h["depth"],
                                        step: 0.1, class: "form-control" %>
                  <div class="invalid-feedback">
                    穴の深さは必須です
                  </div>
                </div>
                <div class="form-text mb-3">
                  加工面からの穴の深さを入力してください。
                </div>
              <% end %>
            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>





      <%# DEBUG %>
      <div class="carousel-item px-4 pt-2">
        <div class="d-block w-100 px-5">
          <pre><%= raw json_escape(
            JSON.pretty_generate(
              @part.as_json(
                only: [:id, :name, :shape_type_code],
                include: {
                  board_part:  { except: [:created_at, :updated_at] },
                  lumber_part: { except: [:created_at, :updated_at] }
                }
              )
            )
          ) %></pre>
        </div>
      </div>

    <% end %>
    <div class="carousel-item px-4 pt-2">
      <div class="d-block w-100 px-5">
        <div class="input-group mb-3">
          <span class="input-group-text">部品名称</span>
          <%= f.text_field :name, class: "form-control", maxlength: 50, required: true %>
          <div class="invalid-feedback">
            部品名称は必須です（50文字以内）
          </div>
        </div>
        <div class="card mb-3">
          <div class="card-header">
            説明文
          </div>
          <%= f.text_area :note,
                  class: "form-control",
                  rows: 2,
                  maxlength: 1000,
                  placeholder: "説明文などをご記入ください" %>
        </div>
        <div class="d-flex flex-grow-1">
          <%= f.submit "登録する", class: "btn btn-primary flex-grow-1" %>
        </div>
      </div>
    </div>
  </div>

  <button class="carousel-control-prev" type="button" data-bs-target="#boardPartForm" data-bs-slide="prev" data-bs-theme="dark">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#boardPartForm" data-bs-slide="next" data-bs-theme="dark">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>