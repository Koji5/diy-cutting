  <div class="carousel-inner" style="min-height: 185px;">
    <div class="carousel-item active px-4 pt-2">
      <div class="d-block w-100 px-5">
        <div class="input-group mb-3">
          <span class="input-group-text">部品名称</span>
          <%= f.text_field :name, class: "form-control", maxlength: 50, required: true %>
          <div class="invalid-feedback">
            部品名称は必須です（50文字以内）
          </div>
        </div>
        <div class="card">
          <div class="card-header">
            説明文
          </div>
          <%= f.text_area :note,
                  class: "form-control",
                  rows: 2,
                  maxlength: 1000,
                  placeholder: "説明文などをご記入ください" %>
        </div>
      </div>
    </div>
    <%= f.fields_for :board_part do |bf| %>
    <%= bf.hidden_field :camera_state_json, id: "camera_state_json" %>
    <div class="carousel-item px-4 pt-2">
      <div class="d-block w-100 px-5">
        <div class="input-group">
          <span class="input-group-text">板の幅 (mm)</span>
          <%= bf.number_field :length_mm, step: 0.1, class: "form-control", required: true %>
          <div class="invalid-feedback">
            板の幅 は必須です
          </div>
        </div>
        <div class="form-text mb-3">
          板の幅は2000mm以内で入力してください。
        </div>
        <div class="input-group">
          <span class="input-group-text">板の高さ (mm)</span>
          <%= bf.number_field :width_mm, step: 0.1, class: "form-control", required: true %>
          <div class="invalid-feedback">
            板の高さ は必須です
          </div>
        </div>
        <div class="form-text mb-3">
          板の高さは1000mm以内で入力してください。
        </div>
        <div class="input-group">
          <span class="input-group-text">板の厚み</span>
          <%= bf.collection_select :thickness_mm, @board_thickness, :thickness_mm, :name_en,
                                { prompt: "選択…" },
                                class: "form-select", required: true %>
          <div class="invalid-feedback">
            板の厚みは必須です
          </div>
        </div>
      </div>
    </div>
    <div class="carousel-item">
      <div class="d-block w-100 px-5">
        <%= bf.label :width_mm, "幅(mm)" %>
        <%= bf.number_field :width_mm, step: 0.1, class: "form-control", required: true %>
      </div>
    </div>
    <div class="carousel-item">
      <div class="d-block w-100 px-5">
        <%= bf.label :length_mm, "長さ(mm)" %>
        <%= bf.number_field :length_mm, step: 0.1, class: "form-control", required: true %>
      </div>
    </div>
    <% end %>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#boardPartForm" data-bs-slide="prev" data-bs-theme="dark">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#boardPartForm" data-bs-slide="next" data-bs-theme="dark">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>