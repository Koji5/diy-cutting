<%= render "board_parts/link_board_part" %>
<section class="m-0">
  <div class="d-flex flex-grow-1" id="preview-pane">
    <div class="bg-light square-half mx-auto" data-controller="board-part3d">
        <canvas data-board-part3d-target="canvas" class="w-100 h-100"></canvas>
    </div>
  </div>
  <%= form_with model: @part,
                url: part_board_part_path(@part),
                data: {
                  turbo_frame: "main",
                  controller: "form-validation",
                  "form-validation-context-value": "board-part-edit"
                },
                html: {
                  class: "needs-validation",
                  novalidate: true
                } do |f| %>
    <div id="boardPartForm" class="carousel slide mt-2">
      <%= render "form_fields", f:, mode: :edit %>
    </div>

  <% end %>
</section>
