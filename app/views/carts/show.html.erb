<%= render "carts/link_cart" %>
<section class="d-flex flex-column px-3 mt-3 ">
  <!-- ✅ 上部：固定のカート情報欄 -->
  <div class="d-flex flex-row flex-grow-1 mb-3" style="min-height: 80px;">
    <div class="d-flex me-3">
      <i class="bi bi-cart-fill me-2 fs-1"></i>
    </div>
    <div class=" flex-grow-1">
      <h5 class="flex-grow-1 min-w-0 mb-1 text-truncate"><%= @cart.name %></h5>
      <p class="mb-0 text-muted small">
        作成日：<%= l(@cart.created_at.to_date) %> / 作成者：<%= @cart.account.name %>
      </p>
      <div class=" flex-grow-1 d-flex justify-content-end">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#rfqConfirmModal">
          見積依頼に進む
        </button>
      </div>
    </div>
  </div>
  <% @cart_parts.each do |cart_part| %>
    <%= render "cart_item_card", item: cart_part.part, target: "part", quantity: cart_part.quantity %>
  <% end %>
  <% @cart_recipes.each do |cart_recipe| %>
    <%= render "cart_item_card", item: cart_recipe.recipe, target: "recipe", quantity: cart_recipe.quantity %>
  <% end %>
</section>

<!-- 見積依頼に進むモーダル定義 -->
<div class="modal fade" id="rfqConfirmModal" tabindex="-1" aria-labelledby="rfqConfirmModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header text-bg-warning">
        <h5 class="modal-title" id="rfqConfirmModalLabel"><i class="bi bi-info-circle me-1"></i>見積依頼に進む前に</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
      </div>
      <div class="modal-body">
        レシピに含まれるパーツは自動で展開され、<br>
        同じパーツがあれば数量が合算されます。
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
        <a href="<%= new_rfq_path(cart_id: @cart.id) %>" class="btn btn-primary">進む</a>
      </div>
    </div>
  </div>
</div>
