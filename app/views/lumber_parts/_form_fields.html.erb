  <% current_mode = (local_assigns[:mode] || :new).to_sym %>
  <% lumber_part = f.object.lumber_part || LumberPart.new %>
  <% raw_holes = lumber_part.hole_json.presence || {} %>
  <% holes = raw_holes.is_a?(Hash) ? raw_holes.deep_stringify_keys : {} %>
  <% max_n = holes.keys.filter_map { |k| k[/\Ah(\d+)\z/, 1]&.to_i }.max || 0 %>
  <% next_index = max_n + 1 %>

  <div class="carousel-inner"
      data-controller="lumber-part-form"
      data-lumber-part-form-base-path-value="part[lumber_part_attributes][hole_json]"
      data-lumber-part-form-next-index-value="<%= next_index %>"
      data-lumber-part-form-colors-value="<%= json_escape(@paint_colors.map { |c|
              { code: c.code, name: c.name_ja, sort: c.sort_order, allow: c.allow_paint_types }
            }.to_json) %>"
      data-lumber-part-form-glosses-value="<%= json_escape(@paint_glosses.map { |g|
              { code: g.code, name: g.name_ja, sort: g.sort_order, allow: g.allow_paint_types }
            }.to_json) %>"
      data-lumber-part-form-finishes-value="<%= json_escape(@paint_finishes.map { |fin|
              { code: fin.code, name: fin.name_ja, sort: fin.sort_order, allow: fin.allow_paint_types }
            }.to_json) %>">
    <%= f.fields_for :lumber_part do |bf| %>
      <%= bf.hidden_field :camera_state_json, id: "camera_state_json" %>
      <%# 基本形状 %>
      <div class="carousel-item active px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 scroll-area col">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">基本形状</div>
              <div class="input-group">
                <span class="input-group-text">角材の種類</span>
                <%= bf.collection_select :lumber_size_code, @lumber_sizes, :code, :label,
                                      { prompt: "選択…" },
                                      class: "form-select", required: true %>
                <div class="invalid-feedback">
                  角材の種類は必須です
                </div>
              </div>
              <div class="form-text mb-2">
                角材の種類を選択してください。
              </div>
              <div class="input-group">
                <span class="input-group-text">角材の長さ (mm)</span>
                <%= bf.number_field :length_mm, step: 0.1, class: "form-control", required: true %>
                <div class="invalid-feedback">
                  棒の長さ は必須です
                </div>
              </div>
              <div class="form-text">
                棒の長さは2000mm以内で入力してください。
              </div>
            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>

      <%# エッジ加工 %>
      <div class="carousel-item px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 scroll-area col">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">エッジ加工</div>
              <% edges = { l: "左（原点）側辺", c: "長辺", r: "右（X方向）側辺" } %>
              <% edges.each do |key, label| %>
                <% h = (bf.object.side_json || {}).dig(key.to_s) || {} %>
                <% edge_sel = h["proc"].presence || "NONE" %>
                <% formName = "part[lumber_part_attributes][side_json][#{key}][disp]" %>
                <% checked_attr = (h["disp"].to_s == "true") ? 'checked="checked"' : '' %>
                <div class="d-flex flex-row flex-grow-1">
                  <div class="d-flex flex-grow-1 fw-bold fs-5 mb-2 ps-2" id="side_<%= "#{key}" %>"><%= "#{label}" %></div>
                  <div class="d-flex form-check form-switch pt-1">
                    <input class="form-check-input" type="checkbox" id="side_<%= "#{key}" %>_disp" name="<%= formName %>" <%= checked_attr %>>
                  </div>
                  <label class="form-check-label form-text" for="side_<%= "#{key}" %>_disp">非表示 <i class="bi bi-arrow-left-right"></i> 表示</label>
                </div>
                <div class="input-group mb-2">
                  <span class="input-group-text">エッジ加工</span>
                  <%= select_tag "part[lumber_part_attributes][side_json][#{key}][proc]",
                                  options_from_collection_for_select(@edge_processes, :code, :name_ja, edge_sel),
                                  class: "form-select" %>
                </div>
                <div class="form-text mb-3">
                  <%= "#{label}" %> 4辺のエッジ加工を選択してください。
                </div>
              <% end %>
            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>

      <%# ネジ・ダボ穴加工 %>
      <div class="carousel-item px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 col scroll-area"
                  data-lumber-part-form-target="scroller">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">ネジ・ダボ穴加工</div>
              <%# 行リスト %>
              <div data-lumber-part-form-target="list">
                <%# キー順は h1, h2, ... の数値順に並べる（数字が無い場合も安定化） %>
                <% ordered_keys = holes.keys.sort_by { |k| [k[/\d+/].to_i, k] } %>
                <% ordered_keys.each do |hid| %>
                  <div class="border rounded-3 p-3 mb-3 row-collapsible" data-lumber-part-form-target="row" data-hid="<%= hid %>">
                    <% h = holes[hid] || {} %>
                    <% surface_sel = h["surface"].presence || "LEFT" %>
                    <% base = "part[lumber_part_attributes][hole_json][#{hid}]" %>
                    <% checked_attr = (h["disp"].to_s == "true") ? 'checked="checked"' : '' %>
                    <% checked_attr_countersink = (h["countersink"].to_s == "true") ? 'checked="checked"' : '' %>
                    <div class="d-flex flex-row flex-grow-1">
                      <div class="d-flex flex-grow-1 fw-bold fs-5 mb-2 ps-2">穴 <%= hid.sub(/^h/, '') %></div>
                      <div class="px-3">
                        <button type="button" class="btn btn-outline-danger btn-sm"
                                data-action="lumber-part-form#remove" aria-label="この穴行を削除">
                          <i class="bi bi-trash"></i>
                        </button>
                      </div>
                      <div class="d-flex form-check form-switch pt-1">
                        <input class="form-check-input" type="checkbox" id="hole_<%= "#{hid}" %>_disp" name="<%= "#{base}[disp]" %>" <%= checked_attr %>>
                      </div>
                      <label class="form-check-label form-text" for="hole_<%= "#{hid}" %>_disp">非表示 <i class="bi bi-arrow-left-right"></i> 表示</label>
                    </div>

                    <div class="input-group mb-2">
                      <span class="input-group-text">加工面</span>
                      <%= select_tag "#{base}[surface]",
                                      options_from_collection_for_select(@hole_surfaces, :code, :name_ja, surface_sel),
                                      class: "form-select" %>
                    </div>
                    <div class="form-text mb-3">穴加工を行う面を選択してください。</div>

                    <div class="input-group">
                      <span class="input-group-text">穴位置X (mm)</span>
                      <%= number_field_tag "#{base}[dx]",
                                            h["dx"],
                                            step: 0.1, class: "form-control" %>
                      <div class="invalid-feedback">穴位置X は必須です</div>
                    </div>
                    <div class="form-text mb-3">X軸（左から）の穴位置を入力してください。</div>

                    <div class="input-group">
                      <span class="input-group-text">穴位置Y (mm)</span>
                      <%= number_field_tag "#{base}[dy]",
                                            h["dy"],
                                            step: 0.1, class: "form-control" %>
                      <div class="invalid-feedback">穴位置Y は必須です</div>
                    </div>
                    <div class="form-text mb-3">Y軸（下から）の穴位置を入力してください。</div>

                    <div class="input-group">
                      <span class="input-group-text">穴の深さ(mm)</span>
                      <%= number_field_tag "#{base}[depth]",
                                            h["depth"],
                                            step: 0.1, class: "form-control" %>
                      <div class="invalid-feedback">穴の深さは必須です</div>
                    </div>
                    <div class="form-text mb-3">加工面からの穴の深さを入力してください。</div>

                    <div class="input-group mb-2">
                      <span class="input-group-text">穴径</span>
                      <%= select_tag "#{base}[spec_code]",
                                      options_from_collection_for_select(@hole_specs, :code, :name_ja, h["spec_code"]),
                                      class: "form-select" %>
                      <div class="input-group-text">
                        <input class="form-check-input" type="checkbox" value=true id="hole_<%= "#{hid}" %>_countersink" name="<%= "#{base}[countersink]" %>" <%= checked_attr_countersink %>>
                        <label class="form-check-label mx-2" for="hole_<%= "#{hid}" %>_countersink">皿取り加工</label>
                      </div>
                    </div>
                    <div class="form-text mb-0">穴径、皿取り加工の有無を入力してください。</div>

                  </div>
                <% end %>
              </div>

              <%# 追加ボタン %>
              <button type="button" class="btn btn-sm btn-primary" data-action="lumber-part-form#add">
                <i class="bi bi-plus-lg me-1"></i>穴を追加
              </button>

              <%# 空のときだけ見せる %>
              <div data-lumber-part-form-target="empty" class="<%= holes.empty? ? '' : 'd-none' %>">
                <div class="callout callout-warning" role="note" aria-label="注意">
                  <div class="callout-title">
                    <i class="bi bi-exclamation-triangle me-1"></i> 注意
                  </div>
                  <p class="mb-0">ネジ・ダボ穴はまだ作成されていません。 「穴を追加」ボタンをクリックしてください。</p>
                </div>
              </div>

              <%# === 追加用テンプレート（__HID__ を Stimulus で置換） === %>
              <template data-lumber-part-form-target="template">
                <div class="border rounded-3 p-3 mb-3 row-collapsible" data-lumber-part-form-target="row">
                  <div class="d-flex flex-row flex-grow-1">
                    <div class="d-flex flex-grow-1 fw-bold fs-5 mb-2 ps-2">穴 __HNUM__</div>
                    <div class="px-3">
                      <button type="button" class="btn btn-outline-danger btn-sm"
                              data-action="lumber-part-form#remove" aria-label="この穴行を削除">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                    <div class="d-flex form-check form-switch pt-1">
                      <input class="form-check-input" type="checkbox" id="hole___HID___disp"
                            name="part[lumber_part_attributes][hole_json][__HID__][disp]">
                    </div>
                    <label class="form-check-label form-text" for="hole___HID___disp">非表示 <i class="bi bi-arrow-left-right"></i> 表示</label>
                  </div>

                  <div class="input-group mb-2">
                    <span class="input-group-text">加工面</span>
                    <select class="form-select"
                            name="part[lumber_part_attributes][hole_json][__HID__][surface]">
                      <% @hole_surfaces.each do |s| %>
                        <option value="<%= s.code %>"><%= s.name_ja %></option>
                      <% end %>
                    </select>
                  </div>
                  <div class="form-text mb-3">穴加工を行う面を選択してください。</div>

                  <div class="input-group">
                    <span class="input-group-text">穴位置X (mm)</span>
                    <input type="number" step="0.1" class="form-control"
                          name="part[lumber_part_attributes][hole_json][__HID__][dx]" disabled>
                    <div class="invalid-feedback">穴位置X は必須です</div>
                  </div>
                  <div class="form-text mb-3">X軸（左から）の穴位置を入力してください。</div>

                  <div class="input-group">
                    <span class="input-group-text">穴位置Y (mm)</span>
                    <input type="number" step="0.1" class="form-control"
                          name="part[lumber_part_attributes][hole_json][__HID__][dy]">
                    <div class="invalid-feedback">穴位置Y は必須です</div>
                  </div>
                  <div class="form-text mb-3">Y軸（下から）の穴位置を入力してください。</div>

                  <div class="input-group">
                    <span class="input-group-text">穴の深さ(mm)</span>
                    <input type="number" step="0.1" class="form-control"
                          name="part[lumber_part_attributes][hole_json][__HID__][depth]">
                    <div class="invalid-feedback">穴の深さは必須です</div>
                  </div>
                  <div class="form-text mb-3">加工面からの穴の深さを入力してください。</div>

                  <div class="input-group mb-2">
                    <span class="input-group-text">穴径</span>
                    <select class="form-select"
                            name="part[lumber_part_attributes][hole_json][__HID__][spec_code]">
                      <% @hole_specs.each do |sp| %>
                        <option value="<%= sp.code %>"><%= sp.name_ja %></option>
                      <% end %>
                    </select>
                    <div class="input-group-text">
                      <input class="form-check-input" type="checkbox" value=true
                            id="hole___HID___countersink"
                            name="part[lumber_part_attributes][hole_json][__HID__][countersink]">
                      <label class="form-check-label mx-2" for="hole___HID___countersink">皿取り加工</label>
                    </div>
                  </div>
                  <div class="form-text mb-0">穴径、皿取り加工の有無を入力してください。</div>

                </div>
              </template>

            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>

      <%# 材質・塗装 %>
      <div class="carousel-item px-4">
        <div class="container">
          <div class="row carousel-row">
            <div class="col carousel-padding"></div>
            <div class="d-block w-100 col scroll-area"
                  data-lumber-part-form-target="scroller">
              <div class="ProcessingHeader fw-bold fs-4 mb-2">材質・塗装</div>

              <div class="input-group">
                <span class="input-group-text">材質</span>
                <%= bf.collection_select :material_code, @materials, :code, :name_ja,
                                      { prompt: "選択…" },
                                      class: "form-select", required: true %>
                <div class="invalid-feedback">
                  材質は必須です
                </div>
              </div>
              <div class="form-text mb-3">材質を選択してください。</div>

              <div class="input-group">
                <span class="input-group-text">塗装タイプ</span>
                <%= bf.collection_select :paint_type_code, @paint_types, :code, :name_ja,
                                      { include_blank: "選択してください" },
                                      class: "form-select",
                                      required: true,
                                      data: { lumber_part_form_target: "type", action: "change->lumber-part-form#onTypeChange" } %>
                <div class="invalid-feedback">
                  塗装タイプは必須です
                </div>
              </div>
              <div class="form-text mb-3">塗装タイプを選択してください。</div>

              <div class="input-group">
                <span class="input-group-text">塗装色</span>
                <%= bf.select :paint_color_code, [],
                                      { include_blank: "先に塗装タイプを選択してください" },
                                      class: "form-select",
                                      data: {
                                        lumber_part_form_target: "color",
                                        current_value: bf.object.paint_color_code
                                      } %>
              </div>
              <div class="form-text mb-3">塗装の色を選択してください。</div>

              <div class="input-group">
                <span class="input-group-text">艶</span>
                <%= bf.select :paint_gloss_code, [],
                                      { include_blank: "先に塗装タイプを選択してください" },
                                      class: "form-select",
                                      data: {
                                        lumber_part_form_target: "gloss",
                                        current_value: bf.object.paint_gloss_code
                                      } %>
              </div>
              <div class="form-text mb-3">塗装の艶を選択してください。</div>

              <div class="input-group">
                <span class="input-group-text">仕上げ</span>
                <%= bf.select :paint_finish_code, [],
                                      { include_blank: "先に塗装タイプを選択してください" },
                                      class: "form-select",
                                      data: {
                                        lumber_part_form_target: "finish",
                                        current_value: bf.object.paint_finish_code
                                      } %>
              </div>
              <div class="form-text mb-3">塗装の仕上げを選択してください。</div>

            </div>
            <div class="col carousel-padding"></div>
          </div>
        </div>
      </div>

    <% end %>
    <%= f.file_field :geometry, id: "geometry_file", direct_upload: true, class: "d-none" %>
    <%= f.file_field :thumbnail, id: "thumbnail_file", accept: "image/*", style: "display:none" %>
    <div class="carousel-item px-4">
      <div class="container">
        <div class="row carousel-row">
          <div class="col carousel-padding"></div>
          <div class="d-block w-100 col scroll-area">
            <div class="ProcessingHeader fw-bold fs-4 mb-2">パーツ情報</div>

            <div class="input-group mb-3">
              <span class="input-group-text">部品名称</span>
              <%= f.text_field :name, class: "form-control", maxlength: 50, required: true %>
              <div class="invalid-feedback">
                部品名称は必須です（50文字以内）
              </div>
            </div>
            <div class="card mb-3">
              <div class="card-header">
                説明文
              </div>
              <%= f.text_area :note,
                      class: "form-control",
                      rows: 2,
                      maxlength: 1000,
                      placeholder: "説明文などをご記入ください" %>
            </div>
            <div class="d-flex flex-grow-1">
              <%= f.submit (current_mode == :edit ? "マイパーツを更新する" : "マイパーツを登録する"),
                          class: "btn btn-primary flex-grow-1" %>
            </div>
          </div>
          <div class="col carousel-padding"></div>
        </div>
      </div>
    </div>
  </div>

  <button class="carousel-control-prev" type="button" data-bs-target="#lumberPartForm" data-bs-slide="prev" data-bs-theme="dark">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Previous</span>
  </button>
  <button class="carousel-control-next" type="button" data-bs-target="#lumberPartForm" data-bs-slide="next" data-bs-theme="dark">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="visually-hidden">Next</span>
  </button>