<!-- app/views/parts/new.html.erb -->
<h1 class="mb-4">部品新規作成 (SID-PR-200)</h1>

<%= form_with model: @part,
              data: {
                controller: "dims",
                dims_rules_value:     GLOBAL_DIM_RULE.to_json,
                dims_hole_diameters_value: MHoleDiameter.order(:hole_mm)
                                            .map { |d| [d.code, d.hole_mm] }.to_h.to_json
              } do |f| %>
  <!-- ▼ タブバー -->
  <ul class="nav nav-pills mb-3 flex-column flex-sm-row" id="partTabs" role="tablist">
    <li class="nav-item flex-sm-fill" role="presentation">
      <button class="nav-link active w-100" id="input-tab"
              data-bs-toggle="tab" data-bs-target="#input-pane"
              type="button" role="tab">入力フォーム</button>
    </li>
    <li class="nav-item flex-sm-fill" role="presentation">
      <button class="nav-link w-100" id="preview-tab"
              data-bs-toggle="tab" data-bs-target="#preview-pane"
              type="button" role="tab">3D プレビュー</button>
    </li>
  </ul>

  <div class="tab-content">
    <!-- ───────── 入力タブ ───────── -->
    <div class="tab-pane fade show active" id="input-pane" role="tabpanel">

      <!-- 部品名称 -->
      <div class="mb-3">
        <%= f.label :name, class: "form-label fw-bold" do %>
          部品名称
          <a href="#" data-bs-toggle="modal" data-bs-target="#help-name">
            <i class="bi bi-question-circle text-secondary"></i>
          </a>
        <% end %>
        <%= f.text_field :name, class: "form-control", required: true %>
      </div>

      <!-- 樹種（m_materials から） -->
      <div class="mb-3">
        <%= f.label :material_code, class: "form-label fw-bold" do %>
          樹種
          <a href="#" data-bs-toggle="modal" data-bs-target="#help-material">
            <i class="bi bi-question-circle text-secondary"></i>
          </a>
        <% end %>
        <%= f.collection_select :material_code, @materials, :code, :name_ja,
                                { prompt: "選択…" },
                                class: "form-select", required: true %>
      </div>

      <!-- ▼ ラッパー開始：3つのコントローラ名を並べる -->
      <div
        data-controller="shapeproc cornerproc edgeproc"
        data-shapeproc-shapes-value='<%= @shapes.index_by(&:code)
                                        .transform_values(&:allow_shape_json)
                                        .to_json %>'
        data-cornerproc-shapes-value='<%= @shapes.index_by(&:code)
                                        .transform_values(&:allow_corner_json)
                                        .to_json %>'
        data-cornerproc-proc-value='<%= MCornerProcess.all.index_by(&:code)
                                        .transform_values(&:allow_corner_proc_json)
                                        .to_json %>'
        data-edgeproc-shapes-value='<%= @shapes.index_by(&:code)
                                   .transform_values(&:allow_edge_json)
                                   .to_json %>'>
        <!-- 平面形状 -->
        <div class="mb-3">
          <%= f.label :shape_code, class: "form-label fw-bold" do %>
            平面形状
            <a href="#" data-bs-toggle="modal" data-bs-target="#help-shape">
              <i class="bi bi-question-circle text-secondary"></i>
            </a>
          <% end %>
          <%= f.collection_select :shape_code, @shapes, :code, :name_ja,
                { prompt: "選択…" },
                class: "form-select", required: true,
                data: {
                  dims_target:      "shape",
                  shapeproc_target: "shape",
                  cornerproc_target:"shape",
                  edgeproc_target:  "shape",
                  action: "dims#shapeChanged shapeproc#shapeChanged cornerproc#shapeChanged edgeproc#shapeChanged"
                } %>
        </div>

        <!-- ───────── 寸法グループ ───────── -->
        <div class="mb-4">

          <label class="form-label fw-bold d-flex align-items-center">
            寸法
            <a href="#" class="ms-1" data-bs-toggle="modal" data-bs-target="#help-dims">
              <i class="bi bi-question-circle text-secondary"></i>
            </a>
          </label>

          <!-- 厚み -->
          <div class="mb-2">
            <%= f.label :thickness_mm, "厚み [mm]", class: "form-label small" %>
            <%= f.number_field :thickness_mm,
                              class: "form-control",
                              step: 1, min: 0, required: true %>
          </div>

          <!-- 巾1 -->
          <div class="mb-2">
            <%= f.label :width1_mm, "巾1 [mm]", class: "form-label small" %>
            <%= f.number_field :width1_mm,
                  class: "form-control",
                  step: 1, min: 0, required: true,
                  data: { dims_target: "width1",
                          action: "input->dims#width1Changed" } %>
          </div>

          <!-- 巾2（ニッチ型のみ） -->
          <div class="mb-2 d-none" data-dims-target="width2Wrap">
            <%= f.label :width2_mm, "巾2 [mm] (ニッチ)", class: "form-label small" %>
            <%= f.number_field :width2_mm,
                              class: "form-control",
                              step: 1, min: 0,
                              data: { dims_target: "width2" } %>
          </div>

          <!-- 長さ -->
          <div class="mb-2">
            <%= f.label :length_mm,
                        class: "form-label small d-flex align-items-center" do %>
              長さ&nbsp;[mm]
              <!-- ▼ 自動入力バッジ（初期は非表示） -->
              <span class="badge bg-info text-dark ms-2 d-none"
                    data-dims-target="autoLengthNote">
                長さは自動入力
              </span>
            <% end %>

            <%= f.number_field :length_mm,
                  class: "form-control",
                  step: 1, min: 0, required: true,
                  data: { dims_target: "length" } %>
          </div>
        </div>

        <%# ==== 加工設定グループ ========================================== %>
        <div>

          <label class="form-label fw-bold d-flex align-items-center">
            加工設定
            <a href="#" class="ms-1" data-bs-toggle="modal" data-bs-target="#help-shapeproc">
              <i class="bi bi-question-circle text-secondary"></i>
            </a>
          </label>

          <%# ============== 半径入力 2 × 2 グリッド ==================== %>
          <div class="row g-2 mb-2">
            <div class="col-6 d-none" data-shapeproc-target="tlWrap">
              <%= f.label :shape_tl_r, "左上半径 [mm]", class: "form-label small" %>
              <%= f.number_field :shape_tl_r,
                    class: "form-control", step: 1, min: 0,
                    data: { shapeproc_target: "tl" } %>
            </div>

            <div class="col-6 d-none" data-shapeproc-target="trWrap">
              <%= f.label :shape_tr_r, "右上半径 [mm]", class: "form-label small" %>
              <%= f.number_field :shape_tr_r,
                    class: "form-control", step: 1, min: 0,
                    data: { shapeproc_target: "tr" } %>
            </div>

            <div class="col-6 d-none" data-shapeproc-target="blWrap">
              <%= f.label :shape_bl_r, "左下半径 [mm]", class: "form-label small" %>
              <%= f.number_field :shape_bl_r,
                    class: "form-control", step: 1, min: 0,
                    data: { shapeproc_target: "bl" } %>
            </div>

            <div class="col-6 d-none" data-shapeproc-target="brWrap">
              <%= f.label :shape_br_r, "右下半径 [mm]", class: "form-label small" %>
              <%= f.number_field :shape_br_r,
                    class: "form-control", step: 1, min: 0,
                    data: { shapeproc_target: "br" } %>
            </div>
          </div>

          <%# ― 入力不要メッセージ ― %>
          <p class="text-muted small d-none" data-shapeproc-target="noneMsg">
            選択した平面形状ではこの STEP の入力は不要です。
          </p>

        </div>

        <%# ==== コーナー加工設定グループ ==================================== %>
        <div
          data-cornerproc-shapes-value='<%= @shapes.index_by(&:code)
                                            .transform_values(&:allow_corner_json)
                                            .to_json %>'
          data-cornerproc-proc-value='<%= MCornerProcess.all.index_by(&:code)
                                          .transform_values(&:allow_corner_proc_json)
                                          .to_json %>'>

          <label class="form-label fw-bold d-flex align-items-center">
            コーナー加工設定 (オプション)
            <a href="#" class="ms-1" data-bs-toggle="modal" data-bs-target="#help-corners">
              <i class="bi bi-question-circle text-secondary"></i>
            </a>
          </label>

          <% corners = { tl: "左上", tr: "右上", bl: "左下", br: "右下" } %>

          <%# ─ 1段目：ドロップダウン (左上・右上) ─ %>
          <div class="row g-2">
            <% corners.slice(:tl, :tr).each do |key, label| %>
              <div class="col-6 mt-2">
                <%= f.label "corner_#{key}_code", "【#{label} 加工】", class: "form-label mb-2" %>
                <%= f.collection_select "corner_#{key}_code", MCornerProcess.all,
                                        :code, :name_ja, { include_blank: false },
                                        class: "form-select",
                                        data: { cornerproc_target: "#{key}Select",
                                                action: "cornerproc#procChanged" } %>
              </div>
            <% end %>
          </div>

          <%# ─ 2段目：パラメータ入力 (左上・右上) ─ %>
          <div class="row g-2 mb-2">
            <% corners.slice(:tl, :tr).each do |key, label| %>
              <div class="col-6">
                <%# R 入力 %>
                <div class="d-none mt-2" data-cornerproc-target="<%= "#{key}RWrap" %>">
                  <%= f.label "corner_#{key}_r", "#{label} 半径 [mm]", class: "form-label small text-muted mb-1" %>
                  <%= f.number_field "corner_#{key}_r", step: 1, min: 0,
                                    class: "form-control",
                                    data: { cornerproc_target: "#{key}R" } %>
                </div>
                <%# dx/dy 入力 %>
                <div class="d-none mt-2" data-cornerproc-target="<%= "#{key}DxDyWrap" %>">
                  <div class="row g-1">
                    <div class="col">
                      <%= f.label "corner_#{key}_dx", "縦 [mm]", class: "form-label small text-muted mb-1" %>
                      <%= f.number_field "corner_#{key}_dx", step: 1, min: 0,
                                        class: "form-control",
                                        data: { cornerproc_target: "#{key}Dx" } %>
                    </div>
                    <div class="col">
                      <%= f.label "corner_#{key}_dy", "横 [mm]", class: "form-label small text-muted mb-1" %>
                      <%= f.number_field "corner_#{key}_dy", step: 1, min: 0,
                                        class: "form-control",
                                        data: { cornerproc_target: "#{key}Dy" } %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <%# ─ 3段目：ドロップダウン (左下・右下) ─ %>
          <div class="row g-2">
            <% corners.slice(:bl, :br).each do |key, label| %>
              <div class="col-6 mt-2">
                <%= f.label "corner_#{key}_code", "【#{label} 加工】", class: "form-label fw-normal mb-2" %>
                <%= f.collection_select "corner_#{key}_code", MCornerProcess.all,
                                        :code, :name_ja, { include_blank: false },
                                        class: "form-select",
                                        data: { cornerproc_target: "#{key}Select",
                                                action: "cornerproc#procChanged" } %>
              </div>
            <% end %>
          </div>

          <%# ─ 4段目：パラメータ入力 (左下・右下) ─ %>
          <div class="row g-2">
            <% corners.slice(:bl, :br).each do |key, label| %>
              <div class="col-6">
                <div class="d-none mt-2" data-cornerproc-target="<%= "#{key}RWrap" %>">
                  <%= f.label "corner_#{key}_r", "#{label} 半径 [mm]", class: "form-label small text-muted mb-1" %>
                  <%= f.number_field "corner_#{key}_r", step: 1, min: 0,
                                    class: "form-control",
                                    data: { cornerproc_target: "#{key}R" } %>
                </div>

                <div class="d-none mt-2" data-cornerproc-target="<%= "#{key}DxDyWrap" %>">
                  <div class="row g-1">
                    <div class="col">
                      <%= f.label "corner_#{key}_dx", "縦 [mm]", class: "form-label small text-muted mb-1" %>
                      <%= f.number_field "corner_#{key}_dx", step: 1, min: 0,
                                        class: "form-control",
                                        data: { cornerproc_target: "#{key}Dx" } %>
                    </div>
                    <div class="col">
                      <%= f.label "corner_#{key}_dy", "横 [mm]", class: "form-label small text-muted mb-1" %>
                      <%= f.number_field "corner_#{key}_dy", step: 1, min: 0,
                                        class: "form-control",
                                        data: { cornerproc_target: "#{key}Dy" } %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <%# 全角とも未許可の場合のメッセージ %>
          <p class="text-muted small d-none" data-cornerproc-target="noneMsg">
            選択した平面形状ではこの STEP の入力は不要です。
          </p>
        </div>

        <%# ==== 丸穴加工設定 (オプション) ================================= %>
        <div
          data-controller="holeproc"
          data-holeproc-diameters-value='<%= MHoleDiameter.order(:hole_mm).map { |d|
                                              [d.code, d.hole_mm] }.to_h.to_json %>'>

          <label class="form-label fw-bold d-flex align-items-center my-3">
            丸穴加工設定 (オプション)
            <a href="#" class="ms-1" data-bs-toggle="modal" data-bs-target="#help-holes">
              <i class="bi bi-question-circle text-secondary"></i>
            </a>
          </label>

          <% corners = { tl:"左上", tr:"右上", bl:"左下", br:"右下" } %>

          <%# ====== 上段 2 角 ================================================= %>
          <div class="row g-3">
            <% corners.slice(:tl, :tr).each do |key, label| %>
              <div class="col-6">

                <%# チェックボックス (1段目) ----------------------------------- %>
                <div class="form-check mb-2">
                  <%= f.check_box "hole_#{key}_flag",
                                  class: "form-check-input",
                                  data: { holeproc_target: "#{key}Flag",
                                          action: "holeproc#flagChanged" } %>
                  <%= f.label "hole_#{key}_flag", "#{label} に丸穴", class: "form-check-label fw-bold" %>
                </div>

                <%# 中心距離 (2段目) ------------------------------------------ %>
                <div class="row g-1 d-none" data-holeproc-target="<%= "#{key}DyDxWrap" %>">
                  <div class="col">
                    <%= f.label "hole_#{key}_dy", "縦距離[mm]",
                                class: "form-label small text-muted mb-1" %>
                    <%= f.number_field "hole_#{key}_dy", step: 1, min: 0,
                                      class: "form-control",
                                      data: { holeproc_target: "#{key}Dy" } %>
                  </div>
                  <div class="col">
                    <%= f.label "hole_#{key}_dx", "横距離[mm]",
                                class: "form-label small text-muted mb-1" %>
                    <%= f.number_field "hole_#{key}_dx", step: 1, min: 0,
                                      class: "form-control",
                                      data: { holeproc_target: "#{key}Dx" } %>
                  </div>
                </div>

                <%# 径セレクト (3段目) --------------------------------------- %>
                <div class="d-none mt-2" data-holeproc-target="<%= "#{key}DiaSelWrap" %>">
                  <%= f.label "hole_#{key}_dia_code", "丸穴直径",
                              class: "form-label small text-muted mb-1" %>
                  <%= f.collection_select "hole_#{key}_dia_code", MHoleDiameter.all,
                                          :code, :name_ja,
                                          { include_blank: "選択…" },
                                          class: "form-select",
                                          data: { holeproc_target: "#{key}DiaSel",
                                                  action: "holeproc#diaChanged dims#refresh" } %>
                </div>

                <%# 径直接入力 (D16P 時のみ／4段目) --------------------------- %>
                <div class="d-none mt-2" data-holeproc-target="<%= "#{key}DiaInputWrap" %>">
                  <%= f.label "hole_#{key}_dia_mm", "丸穴直径[mm]",
                              class: "form-label small text-muted mb-1" %>
                  <%= f.number_field "hole_#{key}_dia_mm", step: 1, min: 0,
                                    class: "form-control",
                                    data: { holeproc_target: "#{key}DiaInput" } %>
                </div>

              </div>
            <% end %>
          </div>

          <%# ====== 下段 2 角 (bl / br) も同じ構造で g-3 row をもう1つ ====== %>
          <div class="row g-3 mt-3">
            <% corners.slice(:bl, :br).each do |key, label| %>
              <div class="col-6">

                <%# チェックボックス (1段目) ----------------------------------- %>
                <div class="form-check mb-2">
                  <%= f.check_box "hole_#{key}_flag",
                                  class: "form-check-input",
                                  data: { holeproc_target: "#{key}Flag",
                                          action: "holeproc#flagChanged" } %>
                  <%= f.label "hole_#{key}_flag", "#{label} に丸穴", class: "form-check-label fw-bold" %>
                </div>

                <%# 中心距離 (2段目) ------------------------------------------ %>
                <div class="row g-1 d-none" data-holeproc-target="<%= "#{key}DyDxWrap" %>">
                  <div class="col">
                    <%= f.label "hole_#{key}_dy", "縦距離[mm]",
                                class: "form-label small text-muted mb-1" %>
                    <%= f.number_field "hole_#{key}_dy", step: 1, min: 0,
                                      class: "form-control",
                                      data: { holeproc_target: "#{key}Dy" } %>
                  </div>
                  <div class="col">
                    <%= f.label "hole_#{key}_dx", "横距離[mm]",
                                class: "form-label small text-muted mb-1" %>
                    <%= f.number_field "hole_#{key}_dx", step: 1, min: 0,
                                      class: "form-control",
                                      data: { holeproc_target: "#{key}Dx" } %>
                  </div>
                </div>

                <%# 径セレクト (3段目) --------------------------------------- %>
                <div class="d-none mt-2" data-holeproc-target="<%= "#{key}DiaSelWrap" %>">
                  <%= f.label "hole_#{key}_dia_code", "丸穴直径",
                              class: "form-label small text-muted mb-1" %>
                  <%= f.collection_select "hole_#{key}_dia_code", MHoleDiameter.all,
                                          :code, :name_ja,
                                          { include_blank: "選択…" },
                                          class: "form-select",
                                          data: { holeproc_target: "#{key}DiaSel",
                                                  action: "holeproc#diaChanged dims#refresh" } %>
                </div>

                <%# 径直接入力 (D16P 時のみ／4段目) --------------------------- %>
                <div class="d-none mt-2" data-holeproc-target="<%= "#{key}DiaInputWrap" %>">
                  <%= f.label "hole_#{key}_dia_mm", "丸穴直径[mm]",
                              class: "form-label small text-muted mb-1" %>
                  <%= f.number_field "hole_#{key}_dia_mm", step: 1, min: 0,
                                    class: "form-control",
                                    data: { holeproc_target: "#{key}DiaInput" } %>
                </div>

              </div>
            <% end %>
          </div>
        </div>

        <%# ==== 四角穴加工設定 (オプション) ================================= %>
        <div data-controller="sqholeproc">

          <label class="form-label fw-bold d-flex align-items-center my-3">
            四角穴加工設定 (オプション)
            <a href="#" class="ms-1" data-bs-toggle="modal" data-bs-target="#help-sqholes">
              <i class="bi bi-question-circle text-secondary"></i>
            </a>
          </label>

          <% corners = { tl:"左上", tr:"右上", bl:"左下", br:"右下" } %>

          <%# ── 上段 2 角 (tl / tr) ─────────────────────────────── %>
          <div class="row g-3">
            <% corners.slice(:tl, :tr).each do |key, label| %>
              <div class="col-6">

                <%# ① チェックボックス ─ 1段目 %>
                <div class="form-check mb-2">
                  <%= f.check_box "sqhole_#{key}_flag",
                                  class: "form-check-input",
                                  data: { sqholeproc_target: "#{key}Flag",
                                          action: "sqholeproc#flagChanged" } %>
                  <%= f.label "sqhole_#{key}_flag", "#{label} に四角穴",
                              class: "form-check-label fw-bold" %>
                </div>

                <%# ② 中心距離 (dy/dx) ─ 2段目 %>
                <div class="row g-1 d-none" data-sqholeproc-target="<%= "#{key}DyDxWrap" %>">
                  <div class="col">
                    <%= f.label "sqhole_#{key}_dy", "縦距離[mm]",
                                class: "form-label small text-muted mb-1" %>
                    <%= f.number_field "sqhole_#{key}_dy",
                                      step: 1, min: 0,
                                      class: "form-control",
                                      data: { sqholeproc_target: "#{key}Dy" } %>
                  </div>
                  <div class="col">
                    <%= f.label "sqhole_#{key}_dx", "横距離[mm]",
                                class: "form-label small text-muted mb-1" %>
                    <%= f.number_field "sqhole_#{key}_dx",
                                      step: 1, min: 0,
                                      class: "form-control",
                                      data: { sqholeproc_target: "#{key}Dx" } %>
                  </div>
                </div>

                <%# ③ 穴サイズ (h/w) ─ 3段目 %>
                <div class="row g-1 d-none mt-2" data-sqholeproc-target="<%= "#{key}HwWrap" %>">
                  <div class="col">
                    <%= f.label "sqhole_#{key}_h", "縦[mm]",
                                class: "form-label small text-muted mb-1" %>
                    <%= f.number_field "sqhole_#{key}_h",
                                      step: 1, min: 0,
                                      class: "form-control",
                                      data: { sqholeproc_target: "#{key}H" } %>
                  </div>
                  <div class="col">
                    <%= f.label "sqhole_#{key}_w", "横[mm]",
                                class: "form-label small text-muted mb-1" %>
                    <%= f.number_field "sqhole_#{key}_w",
                                      step: 1, min: 0,
                                      class: "form-control",
                                      data: { sqholeproc_target: "#{key}W" } %>
                  </div>
                </div>

              </div>
            <% end %>
          </div>

          <%# ── 下段 2 角 (bl / br) ─────────────────────────────── %>
          <div class="row g-3 mt-3">
            <% corners.slice(:bl, :br).each do |key, label| %>
              <div class="col-6">
                <!-- 同じ 3 ブロックをコピペ (key/label だけ変える) -->
                <%# --- チェックボックス --- %>
                <div class="form-check mb-2">
                  <%= f.check_box "sqhole_#{key}_flag",
                                  class: "form-check-input",
                                  data: { sqholeproc_target: "#{key}Flag",
                                          action: "sqholeproc#flagChanged" } %>
                  <%= f.label "sqhole_#{key}_flag", "#{label} に四角穴",
                              class: "form-check-label fw-bold" %>
                </div>
                <%# --- dy/dx --- %>
                <div class="row g-1 d-none" data-sqholeproc-target="<%= "#{key}DyDxWrap" %>">
                  <div class="col">
                    <%= f.label "sqhole_#{key}_dy", "縦距離[mm]",
                                class: "form-label small text-muted mb-1" %>
                    <%= f.number_field "sqhole_#{key}_dy",
                                      step: 1, min: 0,
                                      class: "form-control",
                                      data: { sqholeproc_target: "#{key}Dy" } %>
                  </div>
                  <div class="col">
                    <%= f.label "sqhole_#{key}_dx", "横距離[mm]",
                                class: "form-label small text-muted mb-1" %>
                    <%= f.number_field "sqhole_#{key}_dx",
                                      step: 1, min: 0,
                                      class: "form-control",
                                      data: { sqholeproc_target: "#{key}Dx" } %>
                  </div>
                </div>
                <%# --- h/w --- %>
                <div class="row g-1 d-none mt-2" data-sqholeproc-target="<%= "#{key}HwWrap" %>">
                  <div class="col">
                    <%= f.label "sqhole_#{key}_h", "縦[mm]",
                                class: "form-label small text-muted mb-1" %>
                    <%= f.number_field "sqhole_#{key}_h",
                                      step: 1, min: 0,
                                      class: "form-control",
                                      data: { sqholeproc_target: "#{key}H" } %>
                  </div>
                  <div class="col">
                    <%= f.label "sqhole_#{key}_w", "横[mm]",
                                class: "form-label small text-muted mb-1" %>
                    <%= f.number_field "sqhole_#{key}_w",
                                      step: 1, min: 0,
                                      class: "form-control",
                                      data: { sqholeproc_target: "#{key}W" } %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <%# ==== 断面加工設定 (オプション) =================================== %>
        <div class="my-3">

          <label class="form-label fw-bold d-flex align-items-center my-3">
            断面加工設定 (オプション)
            <a href="#" class="ms-1" data-bs-toggle="modal" data-bs-target="#help-edges">
              <i class="bi bi-question-circle text-secondary"></i>
            </a>
          </label>

          <% dirs = {
            tl:"左上",  t:"上面",  tr:"右上",
            l:"左面",           r:"右面",
            bl:"左下",  b:"下面", br:"右下"
          } %>

          <div class="row g-2">
            <%# ─ 1段目 (tl t tr) ─ %>
            <% [:tl,:t,:tr].each do |key| %>
              <div class="col-4">
                <% if key == :t %>
                  <%= f.label "edge_#{key}_code", dirs[key], class: "form-label small fw-bold" %>
                  <%= f.collection_select "edge_#{key}_code", MEdgeProcess.all,
                                          :code, :name_ja, { include_blank: false },
                                          class: "form-select",
                                          data: { edgeproc_target: "#{key}Select" } %>
                <% else %>
                  <%= f.label "edge_#{key}_code", dirs[key], class: "form-label small fw-bold" %>
                  <%= f.collection_select "edge_#{key}_code", MEdgeProcess.all,
                                          :code, :name_ja, { include_blank: false },
                                          class: "form-select",
                                          data: { edgeproc_target: "#{key}Select" } %>
                <% end %>
              </div>
            <% end %>

            <%# ─ 2段目 (l  spacer  r) ─ %>
            <% [:l, nil, :r].each do |key| %>   <!-- ← :nil → nil -->
              <% if key.present? %>             <!-- present? で nil を除外 -->
                <div class="col-4">
                  <%= f.label "edge_#{key}_code", dirs[key], class: "form-label small fw-bold" %>
                  <%= f.collection_select "edge_#{key}_code", MEdgeProcess.all,
                                          :code, :name_ja, { include_blank: false },
                                          class: "form-select",
                                          data: { edgeproc_target: "#{key}Select" } %>
                </div>
              <% else %>
                <div class="col-4"></div>       <!-- 中央の空白セル -->
              <% end %>
            <% end %>

            <%# ─ 3段目 (bl b br) ─ %>
            <% [:bl,:b,:br].each do |key| %>
              <div class="col-4">
                <%= f.label "edge_#{key}_code", dirs[key], class: "form-label small fw-bold" %>
                <%= f.collection_select "edge_#{key}_code", MEdgeProcess.all,
                                        :code, :name_ja, { include_blank: false },
                                        class: "form-select",
                                        data: { edgeproc_target: "#{key}Select" } %>
              </div>
            <% end %>
          </div>
        </div>

      <!-- ====== ③ ラッパー終了 ====== -->
      </div>

      <%# ==== 塗装設定 (オプション) ======================================= %>
      <div
        data-controller="paintproc"
        data-paintproc-types-value='<%= MPaintType.all.index_by(&:code)
                                        .transform_values(&:allow_paint_json)
                                        .to_json %>'>

        <label class="form-label fw-bold d-flex align-items-center my-3">
          塗装設定 (オプション)
          <a href="#" class="ms-1" data-bs-toggle="modal" data-bs-target="#help-paint">
            <i class="bi bi-question-circle text-secondary"></i>
          </a>
        </label>

        <!-- 塗装種類 -->
        <div class="mb-2">
          <%= f.label :paint_type_code, "塗装種類", class: "form-label small fw-bold" %>
          <%= f.collection_select :paint_type_code,
                MPaintType.order(:code),               # ← code 順で NONE が先頭
                :code, :name_ja,
                { include_blank: false },              # ← “選択 …” を廃止
                class: "form-select",
                data: { paintproc_target: "typeSelect",
                        action: "paintproc#typeChanged" } %>
        </div>

        <!-- 塗装面 -->
        <div class="mb-2">
          <%= f.label :paint_surface_code, "塗装面", class: "form-label small fw-bold" %>
          <%= f.collection_select :paint_surface_code, MPaintSurface.all,
                                  :code, :name_ja, { include_blank: "選択…" },
                                  class: "form-select",
                                  data: { paintproc_target: "surfaceSelect" } %>
        </div>

        <!-- 塗装色 -->
        <div class="mb-2">
          <%= f.label :paint_color_code, "塗装色", class: "form-label small fw-bold" %>
          <%= f.collection_select :paint_color_code, MPaintColor.all,
                                  :code, :name_ja, { include_blank: "選択…" },
                                  class: "form-select",
                                  data: { paintproc_target: "colorSelect" } %>
        </div>

        <!-- 木目・導管仕上げ -->
        <div class="mb-2">
          <%= f.label :grain_finish_code, "木目・導管の見え方", class: "form-label small fw-bold" %>
          <%= f.collection_select :grain_finish_code, MGrainFinish.all,
                                  :code, :name_ja, { include_blank: "選択…" },
                                  class: "form-select",
                                  data: { paintproc_target: "grainSelect" } %>
        </div>

        <!-- ツヤ -->
        <div class="mb-2">
          <%= f.label :gloss_code, "ツヤ", class: "form-label small fw-bold" %>
          <%= f.collection_select :gloss_code, MGloss.all,
                                  :code, :name_ja, { include_blank: "選択…" },
                                  class: "form-select",
                                  data: { paintproc_target: "glossSelect" } %>
        </div>
      </div>

      <%# ==== 備考・メモ ================================================ %>
      <div class="mb-4">
        <%= f.label :note, "備考・メモ", class: "form-label fw-bold" %>
        <%= f.text_area :note,
              rows: 4,
              class: "form-control",
              placeholder: "加工で伝えたいこと、図面番号、注意点などがあれば入力してください" %>
      </div>

      <% if @part.errors.any? %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% @part.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= f.submit "登録する", class: "btn btn-primary" %>
    </div>

    <!-- ───────── 3D プレビュータブ（プレースホルダ） ───────── -->
    <div class="tab-pane fade" id="preview-pane" role="tabpanel">
      <div class="ratio ratio-16x9 bg-light" data-controller="part3d">
          <canvas data-part3d-target="canvas" class="w-100 h-100"></canvas>
      </div>
    </div>
  </div>
<% end %>

<!-- ───────── モーダル群（説明プレースホルダ）───────── -->
<%# 部品名称説明 %>
<div class="modal fade" id="help-name" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">部品名称とは？</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <!-- 説明文をここに記述 -->
        例）「棚板‐上段」など、一覧で識別しやすい名前を入力してください。
      </div>
    </div>
  </div>
</div>

<%# 樹種説明 %>
<div class="modal fade" id="help-material" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">樹種とは？</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <!-- 説明文をここに記述 -->
        樹種（材質）を選択してください。例：シナ合板、ナラ無垢 など。
      </div>
    </div>
  </div>
</div>

<%# 平面形状説明 %>
<div class="modal fade" id="help-shape" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">平面形状とは？</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <!-- 説明文をここに記述 -->
        矩形や三角形など、部品の平面形状を選択してください。
      </div>
    </div>
  </div>
</div>

<!-- ───────── 寸法ヘルプモーダル ───────── -->
<div class="modal fade" id="help-dims" tabindex="-1" aria-hidden="true"
     data-controller="dimhelp" data-dimhelp-target="modal">
  <div class="modal-dialog modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">寸法入力のヒント</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body dim-help-body">
        <!-- Stimulus がここを書き換える -->
      </div>
    </div>
  </div>
</div>

<!-- ───────── 加工設定ヘルプモーダル ───────── -->
<div class="modal fade" id="help-shapeproc" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">加工設定のヒント</h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body" id="shapeproc-help">
      形状を選択すると、ここに説明が入ります。
    </div>
  </div></div>
</div>

<!-- ───────── コーナー(角)加工設定 (オプション)ヘルプモーダル ───────── -->
<div class="modal fade" id="help-corners" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">コーナー加工のヒント</h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body small">
      角丸め (R) は半径を指定 / 角落とし・斜めカットは dx,dy を指定してください。<br>
      形状によって指定できるコーナーが異なります。
    </div>
  </div></div>
</div>

<!-- ───────── 丸穴加工設定 (オプション)ヘルプモーダル ───────── -->
<div class="modal fade" id="help-holes" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">丸穴加工のヒント</h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body small">
      角のチェックを入れると、中心位置 (縦・横) と丸穴径を設定できます。<br>
      <code>16mm 以上</code> を選ぶと任意径を直接入力してください。
    </div>
  </div></div>
</div>

<!-- ───────── 四角穴加工設定 (オプション)ヘルプモーダル ───────── -->
<div class="modal fade" id="help-sqholes" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">四角穴加工のヒント</h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body small">
      角のチェックを入れると、穴中心までの距離 (縦・横) と<br>
      四角穴サイズ (縦・横) を設定できます。
    </div>
  </div></div>
</div>

<!-- ───────── 断面加工設定 (オプション)ヘルプモーダル ───────── -->
<div class="modal fade" id="help-edges" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">断面加工のヒント</h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body small">
      方向ごとに糸面・R 面・ボーズ面などを選択できます。<br>
      平面形状によって選択できない方向はグレーアウトされます。
    </div>
  </div></div>
</div>

<!-- ───────── 塗装ヘルプモーダル ───────── -->
<div class="modal fade" id="help-paint" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5 class="modal-title">塗装設定のヒント</h5>
      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body small">
      <p>塗装種類を選択すると、選べる塗装面・色・導管仕上げ・ツヤが自動で切り替わります。</p>
      <ul class="mb-0">
        <li><strong>選択なし</strong>… 無塗装</li>
        <li><strong>ウレタン塗装</strong>… すべての項目が選択可能</li>
        <li><strong>自然塗装</strong>… 面と色のみ選択可能</li>
      </ul>
    </div>
  </div></div>
</div>
