<div class="thumb-box position-relative"
  data-thumbnail-upload-target="box">
  <!-- プレビュー用 -->
  <% if f.object.persisted? && f.object.thumbnail.attached? %>
    <%= image_tag f.object.thumbnail.variant(resize_to_limit: [300, 300]),
        data: { thumbnail_upload_target: "preview" },
        class: "w-100 h-100 object-fit-cover" %>
  <% else %>
    <%= image_tag "", alt: "プレビュー",
        data: { thumbnail_upload_target: "preview" },
        class: "w-100 h-100 object-fit-cover d-none" %>
  <% end %>
  <!-- カメラアイコン -->
  <div class="position-absolute top-50 start-50 translate-middle">
    <label for="recipe_thumbnail"
          class="camera-button d-flex align-items-center justify-content-center cursor-pointer">
      <i class="bi bi-camera-fill fs-3"></i>
    </label>
  </div>
  <%= f.file_field :thumbnail,
        accept: "image/*",
        class: "d-none",
        id: "recipe_thumbnail",
        data: { action: "change->thumbnail-upload#update",
                thumbnail_upload_target: "input" } %>
  <%= f.hidden_field :remove_thumbnail, value: "0", data: { thumbnail_upload_target: "removeFlag" } %>
  <div class="icon-actions position-absolute top-0 end-0 d-flex gap-1 m-1 z-1">
    <!-- ✕アイコン -->
    <button type="button"
            class="delete-button btn btn-sm btn-light d-flex align-items-center justify-content-center p-1"
            data-action="click->thumbnail-upload#remove"
            title="画像を削除">
      <i class="bi bi-x-lg fs-5"></i>
    </button>
  </div>
</div>