<% menu = [
  {
    path:  -> { edit_recipe_path(@recipe) if @recipe },
    match: -> { controller_name == "recipes" && action_name == "edit" },
    icon:  "pencil",
    label: "編集",
    link:  false                # 編集画面ではリンクを出さない
  },
  {
    path:  -> { recipes_path },
    match: -> { current_page?(recipes_path) },
    icon:  "list-ul",
    label: "一覧",
    link:  true
  },
  {
    path:  -> { new_recipe_path },
    match: -> { current_page?(new_recipe_path) },
    icon:  "plus-lg",
    label: "新規作成",
    link:  true
  }
] %>
<% title_tag = "" %> 
<% menu.each do |item| %>
  <% title_tag = item[:label] if item[:match].call %>
<% end %>

<header class="MainHeader d-flex flex-row align-items-center">
  <h3 class="d-flex px-3 flex-nowrap">
    <i class="bi bi-fork-knife me-2"></i>
    マイレシピ － <%= title_tag %>
  </h3>
  <div class="flex-grow-1 min-w-0">
    <div class="input-group px-3">
      <% menu.each do |item| %>
        <% next if item[:match].call || !item[:link] %>
        <%= link_to item[:path].call,
          data:  { turbo_frame: "main" },
          class: "btn btn-outline-secondary form-control" do %>
          <i class="<%= "bi bi-#{item[:icon]}" %>"></i>&nbsp;<%= item[:label] %>
        <% end %>
      <% end %>
    </div>
  </div>
</header>