<%= render "recipes/link_recipe" %>
<section class="px-3">
  <%= form_with model: @recipe, data: { controller: "thumbnail-upload" } do |f| %>

    <div class="d-flex flex-wrap gap-3 mt-3 mb-3">
      <!-- ★ サムネイル画像 (1:1 プレビュー付) -->
      <style>
        .thumb-box    { width:120px; aspect-ratio:1/1; border:1px dashed var(--bs-secondary); border-radius:.5rem; overflow:hidden; }
        .icon         { color:rgba(255,255,255,.8); text-shadow:0 0 4px rgba(0,0,0,.6); }     /* 半透明＋わずかな影 */
        .overlay-label:hover .icon { color:#fff; }                                             /* ホバー時だけくっきり */
      </style>
      <!-- プレビュー枠 -->
      <div class="thumb-box position-relative"
        data-thumbnail-upload-target="box">
        <!-- プレビュー用 -->
        <% if @recipe.thumbnail.attached? %>
          <%= image_tag @recipe.thumbnail.variant(resize_to_limit: [300, 300]),
              data: { thumbnail_upload_target: "preview" },
              class: "w-100 h-100 object-fit-cover" %>
        <% else %>
          <%= image_tag "", alt: "プレビュー",
              data: { thumbnail_upload_target: "preview" },
              class: "w-100 h-100 object-fit-cover d-none" %>
        <% end %>
        <img data-thumbnail-upload-target="preview"
            class="w-100 h-100 object-fit-cover d-none" alt="プレビュー">
        <!-- カメラアイコン -->
        <label for="recipe_thumbnail"
              class="overlay-label position-absolute w-100 h-100 top-0 start-0 d-flex
                      align-items-center justify-content-center cursor-pointer">
          <i class="bi bi-camera-fill fs-1 icon"></i>
        </label>
        <%= f.file_field :thumbnail,
              accept: "image/*",
              class: "d-none",
              id: "recipe_thumbnail",
              data: { action: "change->thumbnail-upload#update",
                      thumbnail_upload_target: "input" } %>
      </div>
      <!-- レシピ名 -->
      <div class="flex-grow-1 align-self-end">
        <div class="input-group">
          <span class="input-group-text"><%= f.label :name, 'レシピ名', class: 'form-label' %></span>
          <%= f.text_field :name, class: 'form-control', autofocus: true %>
        </div>
      </div>
    </div>

    <div class="d-flex flex-column"
        data-controller="recipe-builder"
        style="min-height:520px;">
      <!-- ドロップゾーン -->
      <div class="form-floating mb-3 flex-grow-1">
        <main data-recipe-builder-target="dropZone" id="floatingInput"
              class="d-flex flex-wrap align-content-start overflow-auto form-control"
              style="min-height: 256px;">
          <% @recipe_parts.each do |recipe_part| %>
            <%= render "part_card", part: recipe_part.part, quantity: recipe_part.quantity %>
          <% end %>
        </main>
        <label for="floatingInput">ここにドロップしてください</label>
      </div>
      <!-- アイコン -->
      <div class="d-flex justify-content-center mb-3">
        <i class="bi bi-arrows-vertical"></i>
      </div>
      <div class="form-floating flex-grow-1">
        <!-- 部品一覧 -->
        <div data-recipe-builder-target="partsList"
              class="overflow-auto form-control"
              style="min-height:256px;"
              id="floatingPartsList">
          <% @excluded_parts.each do |excluded_part| %>
            <%= render "part_card", part: excluded_part %>
          <% end %>
        </div>
        <label for="floatingPartsList">選択可能部品一覧</label>
      </div>
      <!-- hidden JSON -->
      <%= hidden_field_tag 'recipe[parts_json]', '', id: 'recipe_parts_json',
            data: { recipe_builder_target: 'hidden' } %>
    </div>

    <!-- 登録ボタン -->
    <%= f.submit '登録', class: 'btn btn-primary w-100 mt-3' %>

  <% end %>
</section>
<!-- Bootstrap トースト -->
<!-- %= render 'shared/toast' % -->
<!-- --- 部品詳細モーダル骨格 -------------------- -->
<div class="modal fade" id="partModal" tabindex="-1" data-controller="part-show-modal">
  <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">
    <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">部品詳細</h5>
          <button class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <turbo-frame id="part_modal" data-action="turbo:frame-load->part-show-modal#open"></turbo-frame>
        </div>
    </div>
  </div>
</div>
