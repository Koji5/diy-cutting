<%#== 1:1 48px サムネイル / プレースホルダ ==%>
<% thumb_tag =
    if part.thumbnail.attached?
      image_tag(part.thumbnail
                    .variant(resize_to_fill: [100, 100]),
                loading: "lazy",
                decoding: "async",
                width: 84, height: 84,
                class: "img-fluid rounded-start")
    else
      tag.div "No image",
              class: "img-fluid rounded-start",
              style: "width:84px; height:84px;",
              role: "img",
              aria: { label: "No image" }
    end
%>
<div class="card part-card mb-2"
    data-recipe-builder-target="item"
    data-part-id="<%= part.id %>"
    data-part-name="<%= j part.name %>"
    data-thumb-url="<%= part.thumbnail.attached? ? url_for(part.thumbnail.variant(resize_to_fill: [48,48])) : asset_path('no_thumb.svg') %>"
    draggable="true">
  <div class="d-flex flex-row flex-grow-1">
    <div style="min-width:84px;">
      <%= thumb_tag %>
    </div>
      <div class="d-flex flex-grow-1">
      <div class="card-body p-2">
        <div class="flex-grow-1 min-w-0 text-truncate mb-2"><%= part.name %></div>
        <div class="d-flex flex-row">
          <div class="d-flex flex-grow-1 align-items-center">
            <span class="badge rounded-pill text-bg-info">パーツ</span>
          </div>
          <div class="d-flex flex-row">
            <fieldset class="input-group flex-shrink-1 flex-grow-0 me-3"
                  role="group" style="max-width:130px;"
                  data-part-id="<%= part.id %>">
              <button type="button"
                      class="btn btn-outline-secondary interactive-lock"
                      data-turbo="false"
                      data-action="click->recipe-builder#decrease"
                      data-remove-btn-for="<%= part.id %>">
                <i class="bi bi-trash"></i>
              </button>
              <input data-quantity-for="<%= part.id %>"
                    <% if defined?(quantity) %>
                      value="<%= quantity %>"
                    <% else %>
                      value="0"
                    <% end %>
                    class="form-control text-center interactive-lock"
                    data-action="change->recipe-builder#onChangeQty"
                    type="number" step="1" required>
              <button type="button"
                      class="btn btn-outline-secondary"
                      data-turbo="false"
                      data-action="click->recipe-builder#increase">＋</button>
            </fieldset>
            <%= link_to show_modal_part_path(part),
                    data: { turbo_frame: "part_modal" },
                    class: "btn btn-outline-secondary btn-icon eye-area",
                    style: "min-width: 40px;" do %>
              <i class="bi bi-eye"></i>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
