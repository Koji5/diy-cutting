<%= render "recipes/link_recipe" %>
<section class="d-flex flex-column px-3 mt-3 overflow-auto form-control border-0">
  <% @recipes.each do |recipe| %>
    <% thumb_tag =
        if recipe.thumbnail.attached?
          image_tag(recipe.thumbnail.variant(resize_to_fill: [40, 40]),
                    loading: "lazy",
                    decoding: "async",
                    width: 40, height: 40,
                    class: "rounded me-2 flex-shrink-0")
        else
          tag.div "No image",
                  class: "border rounded me-2 d-flex align-items-center text-center text-body-secondary lh-sm",
                  style: "width:40px; height:40px; font-size:12px;",
                  role: "img",
                  aria: { label: "No image" }
        end
    %>
    <div id="<%= dom_id(recipe) %>" data-controller="remove-card" class="card d-flex flex-row flex-grow-1 align-items-center mb-2 px-2 py-1">
      <%= thumb_tag %>
      <div class="flex-grow-1 min-w-0 me-2 text-truncate"><%= recipe.name %></div>
      <!-- 詳細 -->
      <%= link_to recipe_path(recipe), data: { turbo_frame: "main" }, class: "btn btn-outline-secondary btn-icon me-2", style: "min-width: 40px;" do %>
        <i class="bi bi-eye"></i>
      <% end %>
      <!-- 編集 -->
      <%= link_to edit_recipe_path(recipe), data: { turbo_frame: "main" }, class: "btn btn-outline-primary btn-icon me-2" do %>
        <i class="bi bi-pencil"></i>
      <% end %>
      <!-- 削除 (フォーム方式で確実に DELETE) -->
      <%= button_to recipe_path(recipe),
                    method: :delete,
                    form: { data: { turbo_confirm: "このレシピを削除しますか?"}, class: "d-inline" },
                    class: "btn btn-outline-danger btn-icon" do %>
        <i class="bi bi-trash"></i>
      <% end %>
    </div>
  <% end %>
</section>
