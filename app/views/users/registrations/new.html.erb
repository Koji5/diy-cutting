<h2>Sign up</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "users/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :email %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="field">
    <%= f.label :password %>
    <% if @minimum_password_length %>
    <em>(<%= @minimum_password_length %> characters minimum)</em>
    <% end %><br />
    <%= f.password_field :password, autocomplete: "new-password" %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <%= f.fields_for :account do |a| %>
    <div class="field">
      <%= a.label :nickname %>
      <%= a.text_field :nickname %>
    </div>

    <div class="field">
      <%= a.label :legal_type %>
      <%= a.select :legal_type, [["個人", "individual"], ["法人", "corporation"]] %>
    </div>

    <div class="field">
      <%= a.label :name %>
      <%= a.text_field :name %>
    </div>

    <div class="field">
      <%= a.label :name_kana %>
      <%= a.text_field :name_kana %>
    </div>

    <div class="field">
      <%= a.label :birthday %>
      <%= a.date_field :birthday %>
    </div>

    <div class="field">
      <%= a.label :gender %>
      <%= a.select :gender, [['男性', 'M'], ['女性', 'F'], ['その他', 'X']] %>
    </div>
  <% end %>

  <div class="actions">
    <%= f.submit "Sign up" %>
  </div>
<% end %>

<%= render "users/shared/links" %>
