<turbo-frame
      id="modalTurboFrame"
      data-action="turbo:frame-load->modal#open turbo:submit-end->modal#autoClose">
  <div>
    <input type="hidden" id="modalMetaTitle" value="保存内容の確認">
    <%= form_with url: service_area_path, method: :patch do |f| %>

      <p><strong>変更前：</strong><%= @previous_summary %></p>
      <p><i class="bi bi-arrow-down"></i></p>
      <p><strong>変更後：</strong><%= @summary %></p>
      <input type="hidden" name="payload" value="<%= json_escape(@payload) %>">
      <div class="d-flex justify-content-end">
        <%= f.submit "登録", class: "btn btn-primary" %>
      </div>
    <% end %>

  </div>
</turbo-frame>
