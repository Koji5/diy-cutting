<%= form_with model: @vendor_profile,
              url: vendor_profile_path,
              data: {
                      turbo_frame: "main",
                      controller: "form-validation",
                      "form-validation-context-value": "vendor_profile-new"
              },
              html: {
                class: "needs-validation",
                novalidate: true
              } do |f| %>

  <!-- メールアドレス -->
  <div class="input-group mb-3">
    <span class="input-group-text">メールアドレス</span>
    <%= f.text_field :office_email, class: "form-control", maxlength: 200 %>
    <div class="invalid-feedback">
      メールアドレスは200文字以内です
    </div>
  </div>

  <!-- 適格請求書発行事業者番号 -->
  <div class="input-group mb-3">
    <span class="input-group-text">適格請求書発行事業者番号</span>
    <%= f.text_field :invoice_number, class: "form-control", maxlength: 20 %>
    <div class="invalid-feedback">
      適格請求書発行事業者番号は20文字以内です
    </div>
  </div>

  <!-- 窓口担当者 -->
  <div class="card mb-3">
    <div class="card-header">
      窓口担当者
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item">
        <!-- 窓口担当者名 -->
        <div class="input-group mb-3">
          <span class="input-group-text">窓口担当者名</span>
          <%= f.text_field :contact_person_name, class: "form-control", maxlength: 80 %>
          <div class="invalid-feedback">
            窓口担当者名は80文字以内です
          </div>
        </div>
        <!-- 窓口担当者名カナ -->
        <div class="input-group mb-3">
          <span class="input-group-text">窓口担当者名カナ</span>
          <%= f.text_field :contact_person_kana, class: "form-control", maxlength: 80 %>
          <div class="invalid-feedback">
            窓口担当者名カナは80文字以内です
          </div>
        </div>
        <!-- 窓口電話番号 -->
        <div class="input-group mb-3">
          <span class="input-group-text">窓口電話番号</span>
          <%= f.telephone_field :contact_phone_number, class: "form-control", maxlength: 30, pattern: "[0-9()\\-]*" %>
          <div class="invalid-feedback">
            窓口電話番号は半角数字・( )・- のみで入力してください（30文字以内） 
          </div>
        </div>
      </li>
    </ul>
  </div>

  <!-- 事業所 -->
  <div class="card mb-3">
    <div class="card-header">
      事業所
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item">

        <!-- アドレス帳からコピー -->
        <div class="d-flex justify-content-end mt-1 mb-3">
          <button type="button" class="btn btn-outline-primary" id="copyBtn">
            アドレス帳からコピー
          </button>
        </div>

        <!-- 事業所名 -->
        <div class="input-group mb-3">
          <span class="input-group-text">事業所名</span>
          <%= @account.name %>
        </div>

        <!-- 事業所名名カナ -->
        <div class="input-group mb-3">
          <span class="input-group-text">事業所名カナ</span>
          <%= @account.name_kana %>
        </div>

        <!-- 事業所部署 -->
        <div class="input-group mb-3">
          <span class="input-group-text">事業所部署</span>
          <%= f.text_field :office_department, id: "department_field", class: "form-control", maxlength: 200 %>
          <div class="invalid-feedback">
            事業所部署は100文字以内です
          </div>
        </div>

        <!-- 事業所電話番号 -->
        <div class="input-group mb-3">
          <span class="input-group-text">事業所電話番号</span>
          <%= f.telephone_field :office_phone_number, id: "phone_number_field", class: "form-control", maxlength: 30, required: true, pattern: "[0-9()\\-]*" %>
          <div class="invalid-feedback">
            事業所電話番号は半角数字・( )・- のみで入力してください（30文字以内） 
          </div>
        </div>

        <%= render "shared/address_fields",
            form: f,
            prefectures: @prefectures,
            zip_col:  :office_postal_code,
            pref_col: :office_prefecture_code,
            city_col: :office_city_code,
            line_col: :office_address_line %>

        <div class="d-flex justify-content-end form-check mb-4">
          <%= f.check_box :add_flag, class: "form-check-input me-2" %>
          <%= f.label :add_flag, "#{action}時にアドレス帳に追加する", class: "form-check-label" %>
        </div>
      </li>
    </ul>
  </div>

  <!-- 振込銀行口座 -->
  <div class="card mb-3">
    <div class="card-header">
      振込銀行口座
    </div>
    <ul class="list-group list-group-flush">
      <li class="list-group-item">
        <div data-controller="bank-branch">
          <!-- 銀行名 -->
          <div class="input-group">
            <span class="input-group-text">銀行名</span>
            <%= f.text_field :bank_name,
              id: "bank-input",
              class: "form-control",
              data: { "bank-branch-target" => "bankInput" } %>
          </div>
          <ul class="list-group" data-bank-branch-target="bankSuggestions" style="margin-left:74px;" hidden></ul>
          <%= f.hidden_field :bank_code, data: { "bank-branch-target" => "bankCode" }, required: true %>
          <div class="invalid-feedback">
            銀行名は必須です
          </div>
          <!-- 支店名 -->
          <div class="input-group mt-3">
            <span class="input-group-text">支店名</span>
            <%= f.text_field :branch_name,
              id: "branch-input",
              class: "form-control",
              data: { "bank-branch-target" => "branchInput" } %>
          </div>
          <ul class="list-group" data-bank-branch-target="branchSuggestions" style="margin-left:74px;" hidden></ul>
          <%= f.hidden_field :branch_code,
            data: {
              "bank-branch-target" => "branchCode"
              }, required: true %>
          <div class="invalid-feedback">
            支店名は必須です
          </div>
        </div>
      </li>
    </ul>
  </div>

  <div class="d-flex">
    <%= f.submit "#{action}する", class: "btn btn-primary flex-grow-1" %>
  </div>
<% end %>