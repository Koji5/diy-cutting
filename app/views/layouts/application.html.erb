<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <%= stylesheet_link_tag "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css", media: "all", rel: "stylesheet", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag "https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.css", media: "all", rel: "stylesheet", crossorigin: "anonymous" %>
  </head>

  <body class="d-flex flex-column min-vh-100" data-controller="page-loading">

    <%# ===== Now Loading GIF ===== %>
    <div
      data-page-loading-target="overlay"
      class="loading-overlay position-fixed top-0 start-0 w-100 h-100
            bg-white bg-opacity-75 d-flex align-items-center justify-content-center"
      style="z-index:2000">
      <img src="<%= asset_path('loading.gif') %>" alt="Loading…" width="48" height="48">
    </div>

    <%# ===== 左サイドバーレール ===== %>
    <nav class="SideRail d-flex flex-column pt-3 border-end bg-white">
      <%# サンプルリンク: アイコンだけ（md以下）/アイコン+ラベル（lg以上） %>
      <%= link_to root_path, class: "SideLink mb-2" do %>
        <i class="bi bi-house fs-4" aria-label="ホーム"></i>
        <span class="SideLabel ms-3">ホーム</span>
      <% end %>
      <%= link_to new_part_path, data: { turbo_frame: "main" }, class: "SideLink mb-2" do %>
        <i class="bi bi-puzzle fs-4" aria-label="パーツ"></i>
        <span class="SideLabel ms-3">パーツ</span>
      <% end %>
      <%= link_to new_recipe_path, data: { turbo_frame: "main" }, class: "SideLink mb-2" do %>
        <i class="bi bi-fork-knife fs-4" aria-label="レシピ"></i>
        <span class="SideLabel ms-3">レシピ</span>
      <% end %>
    </nav>

    <%# ===== RIGHT PLACEHOLDER RAIL ===== %>
    <aside class="RightRail d-none d-xl-flex flex-column border-start bg-white align-items-center justify-content-center text-secondary">
      <p class="px-3 text-center small mb-0">placeholder</p>
    </aside>

    <%# ===== メインコンテンツ ===== %>
    <main class="Main">
      <%# ===== フラッシュメッセージ ===== %>
      <div class="container-fluid">
        <% flash.each do |type, message| %>
          <% bs = { "notice" => "success", "alert" => "danger" }[type] || "info" %>
          <div class="alert alert-<%= bs %> alert-dismissible fade show" role="alert">
            <%= message %>
            <button class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% end %>
      </div>
      <%= yield %>
    </main>
    <%# ===== BOTTOM TAB BAR (Mobile) ===== %>
    <nav class="BottomBar d-flex d-md-none border-top bg-white">
      <%= link_to root_path, class: "BottomLink flex-fill" do %>
        <i class="bi bi-house fs-5"></i>
      <% end %>
      <%= link_to new_part_path, data: { turbo_frame: "main" }, class: "BottomLink flex-fill" do %>
        <i class="bi bi-puzzle fs-5"></i>
      <% end %>
      <%= link_to new_recipe_path, data: { turbo_frame: "main" }, class: "BottomLink flex-fill" do %>
        <i class="bi bi-fork-knife fs-5"></i>
      <% end %>
      <%# 追加アイコン… %>
    </nav>
    <%# ===== トーストエリア ===== %>
    <turbo-frame id="toast-frame" target="_top"></turbo-frame>

  </body>
</html>
